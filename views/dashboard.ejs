<%- include('partials/header') %>

<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <h2><i class="bi bi-speedometer2"></i> Tableau de bord</h2>
      <p class="text-muted">Vue d'ensemble du système de formation</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Statistics Cards -->
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-0">Formateurs Certifiés</h6>
              <h2 class="mb-0 mt-2" id="certified-count">-</h2>
            </div>
            <i class="bi bi-award-fill" style="font-size: 3rem; opacity: 0.3;"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-0">En Formation</h6>
              <h2 class="mb-0 mt-2" id="pending-count">-</h2>
            </div>
            <i class="bi bi-hourglass-split" style="font-size: 3rem; opacity: 0.3;"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-0">Sessions Actives</h6>
              <h2 class="mb-0 mt-2" id="active-sessions">-</h2>
            </div>
            <i class="bi bi-calendar-check-fill" style="font-size: 3rem; opacity: 0.3;"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card bg-warning text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-0">Total Formateurs</h6>
              <h2 class="mb-0 mt-2" id="total-count">-</h2>
            </div>
            <i class="bi bi-people-fill" style="font-size: 3rem; opacity: 0.3;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Dashboard Calendar ──────────────────────────────── -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <button id="db-cal-prev" class="btn btn-sm btn-outline-light py-0 px-2">&#8249;</button>
            <h5 class="mb-0" id="db-cal-title"><i class="bi bi-calendar-heart me-2"></i>…</h5>
            <button id="db-cal-next" class="btn btn-sm btn-outline-light py-0 px-2">&#8250;</button>
          </div>
          <a href="/schedule/holidays" class="btn btn-sm btn-outline-light">
            <i class="bi bi-plus-circle me-1"></i>Gérer les congés
          </a>
        </div>
        <div class="card-body p-3">

          <style>
            .db-cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 6px; }
            .db-cal-dow  { text-align:center; font-size:0.72rem; font-weight:700; color:#888;
                           text-transform:uppercase; letter-spacing:.06em; padding-bottom:4px; }
            .db-cal-day  { min-height:72px; border-radius:8px; border:1px solid #eee;
                           padding:6px 8px; position:relative; background:#fff;
                           transition: box-shadow .12s; }
            .db-cal-day:hover { box-shadow:0 2px 8px rgba(0,23,67,.10); }
            .db-cal-day.db-today { border-color:var(--dc-blue); background:#f0f8ff; }
            .db-cal-day.db-has-hol { background:#fff8f3; border-color:#ffcc99; }
            .db-cal-day.db-other-month { background:#f9f9f9; }
            .db-day-num  { font-size:0.82rem; font-weight:700; color:#333; line-height:1; }
            .db-today .db-day-num { color:var(--dc-blue); }
            .db-other-month .db-day-num { color:#ccc; }
            .db-hol-pill { display:flex; align-items:center; gap:4px; margin-top:3px;
                           background:#fff3e0; border-radius:4px; padding:2px 5px;
                           font-size:0.68rem; font-weight:600; color:#c45000; line-height:1.3;
                           overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
            .db-hol-pill.Maladie  { background:#fce4ec; color:#880e4f; }
            .db-hol-pill.Férié    { background:#e8f5e9; color:#1b5e20; }
            .db-hol-pill.Formation{ background:#e3f2fd; color:#0d47a1; }
            .db-hol-pill.Autre    { background:#f3e5f5; color:#4a148c; }
            .db-more    { font-size:0.62rem; color:#999; margin-top:2px; }
            .db-sess-pill { display:flex; align-items:center; gap:4px; margin-top:3px;
                            background:#e3f2fd; border-radius:4px; padding:2px 5px;
                            font-size:0.68rem; font-weight:600; color:#0d47a1; line-height:1.3;
                            overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
            .db-legend { display:flex; gap:14px; margin-bottom:10px; flex-wrap:wrap; }
            .db-legend-item { display:flex; align-items:center; gap:5px; font-size:0.75rem; color:#555; }
          </style>

          <!-- Legend -->
          <div class="db-legend">
            <div class="db-legend-item">
              <span style="width:12px;height:12px;border-radius:3px;background:#fff3e0;border:1px solid #ffcc99;display:inline-block;"></span>
              🏖️ Congés / Absences
            </div>
            <div class="db-legend-item">
              <span style="width:12px;height:12px;border-radius:3px;background:#e3f2fd;border:1px solid #90caf9;display:inline-block;"></span>
              📋 Formations en cours
            </div>
            <div class="db-legend-item">
              <span style="width:12px;height:12px;border-radius:3px;background:#f0f8ff;border:1px solid var(--dc-blue);display:inline-block;"></span>
              Aujourd'hui
            </div>
          </div>

          <div class="db-cal-grid" id="db-cal-dow-row">
            <% ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'].forEach(d => { %>
              <div class="db-cal-dow"><%= d %></div>
            <% }); %>
          </div>
          <div class="db-cal-grid mt-1" id="db-cal-grid"></div>

        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <!-- Process Overview -->
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Processus "Former les Formateurs"</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-search text-primary" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>1. Identification</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Sélection des candidats</p>
              </div>
            </div>
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-book text-info" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>2. Formation</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Session TWI</p>
              </div>
            </div>
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-calendar text-success" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>3. Planification</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Organisation</p>
              </div>
            </div>
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-clipboard-check text-warning" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>4. Évaluation</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Grille de compétences</p>
              </div>
            </div>
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-award text-danger" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>5. Certification</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Certificat interne</p>
              </div>
            </div>
            <div class="col-md-2">
              <div class="p-3 border rounded">
                <i class="bi bi-arrow-repeat text-secondary" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2 small"><strong>6. Amélioration</strong></p>
                <p class="mb-0 text-muted" style="font-size: 0.8rem;">Suivi continu</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// ── Stats ────────────────────────────────────────────────
fetch('/api/dashboard/stats')
  .then(r => r.json())
  .then(data => {
    document.getElementById('certified-count').textContent  = data.certified     || 0;
    document.getElementById('pending-count').textContent    = data.pending        || 0;
    document.getElementById('active-sessions').textContent  = data.activeSessions || 0;
    document.getElementById('total-count').textContent      = data.total          || 0;
  })
  .catch(() => {});

// ── Dashboard Calendar ───────────────────────────────────
(function() {
  const MONTHS = ['Janvier','Février','Mars','Avril','Mai','Juin',
                  'Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
  const HOL_ICON = { 'Congé':'🏖️','Maladie':'🤒','Férié':'🎉','Formation':'📚','Autre':'📋' };

  const now = new Date();
  let viewYear  = now.getFullYear();
  let viewMonth = now.getMonth();
  let holidayMap = {}; // 'YYYY-MM-DD' -> [{employee_nom, type, notes}]
  let sessionMap = {}; // 'YYYY-MM-DD' -> [{employee_name, poste}]

  function iso(y, m, d) {
    return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
  }

  function expandRangeIntoMap(map, items, startKey, endKey, y, m) {
    const monthFirst = iso(y, m, 1);
    const monthLast  = iso(y, m, new Date(y, m+1, 0).getDate());
    items.forEach(item => {
      const start = new Date((item[startKey] || monthFirst) + 'T12:00:00');
      const end   = new Date((item[endKey]   || monthLast)  + 'T12:00:00');
      for (let d = new Date(start); d <= end; d.setDate(d.getDate()+1)) {
        const key = d.toISOString().slice(0,10);
        if (!map[key]) map[key] = [];
        map[key].push(item);
      }
    });
  }

  function loadAndRender(y, m) {
    const from = iso(y, m, 1);
    const to   = iso(y, m, new Date(y, m+1, 0).getDate());

    document.getElementById('db-cal-title').innerHTML =
      `<i class="bi bi-calendar-heart me-2"></i>${MONTHS[m]} ${y}`;

    // Fetch both in parallel
    Promise.all([
      fetch(`/api/holidays?from=${from}&to=${to}`).then(r => r.ok ? r.json() : []),
      fetch(`/api/sessions-calendar?from=${from}&to=${to}`).then(r => r.ok ? r.json() : [])
    ]).then(([holidays, sessions]) => {
      holidayMap = {};
      sessionMap = {};
      expandRangeIntoMap(holidayMap, holidays, 'date_start', 'date_end', y, m);
      expandRangeIntoMap(sessionMap, sessions, 'date_debut', 'date_fin',  y, m);
      renderGrid(y, m);
    }).catch(() => renderGrid(y, m));
  }

  function renderGrid(y, m) {
    const grid    = document.getElementById('db-cal-grid');
    const todayISO = new Date().toISOString().slice(0,10);
    const total   = new Date(y, m+1, 0).getDate();
    const firstDOW = new Date(y, m, 1).getDay(); // 0=Sun
    const offset  = firstDOW === 0 ? 6 : firstDOW - 1;

    grid.innerHTML = '';

    // Empty cells from previous month
    for (let i = 0; i < offset; i++) {
      const cell = document.createElement('div');
      cell.className = 'db-cal-day db-other-month';
      const prevMonthTotal = new Date(y, m, 0).getDate();
      const pDay = prevMonthTotal - offset + i + 1;
      cell.innerHTML = `<div class="db-day-num">${pDay}</div>`;
      grid.appendChild(cell);
    }

    // Days of current month
    for (let d = 1; d <= total; d++) {
      const key  = iso(y, m, d);
      const hols = holidayMap[key] || [];
      const sess = sessionMap[key] || [];
      const cell = document.createElement('div');
      cell.className = 'db-cal-day';
      if (key === todayISO)               cell.classList.add('db-today');
      if (hols.length > 0)                cell.classList.add('db-has-hol');
      else if (sess.length > 0)           cell.style.background = '#f0f7ff';

      let html = `<div class="db-day-num">${d}</div>`;

      // Show up to 2 holiday pills
      const maxHol = sess.length > 0 ? 1 : 2;
      hols.slice(0, maxHol).forEach(h => {
        const icon = HOL_ICON[h.type] || '📋';
        html += `<div class="db-hol-pill ${h.type}" title="${h.employee_nom} — ${h.type}${h.notes ? ': '+h.notes : ''}">
          <span>${icon}</span><span style="overflow:hidden;text-overflow:ellipsis;">${h.employee_nom}</span>
        </div>`;
      });

      // Show up to 2 session pills
      sess.slice(0, 2).forEach(s => {
        html += `<div class="db-sess-pill" title="${s.employee_name}${s.poste ? ' — '+s.poste : ''} (En cours)">
          <span>📋</span><span style="overflow:hidden;text-overflow:ellipsis;">${s.employee_name}</span>
        </div>`;
      });

      // Overflow count
      const extra = (hols.length - maxHol) + (sess.length > 2 ? sess.length - 2 : 0)
                  + Math.max(0, hols.length - maxHol);
      const totalExtra = Math.max(0, (hols.length - maxHol)) + Math.max(0, sess.length - 2);
      if (totalExtra > 0) html += `<div class="db-more">+${totalExtra} autre(s)</div>`;

      cell.innerHTML = html;

      // Click: holidays take priority, else go to training
      if (hols.length > 0) {
        cell.style.cursor = 'pointer';
        cell.addEventListener('click', () => window.location.href = '/schedule/holidays');
      } else if (sess.length > 0) {
        cell.style.cursor = 'pointer';
        cell.addEventListener('click', () => window.location.href = '/training');
      }
      grid.appendChild(cell);
    }

    // Fill remaining cells
    const filled = offset + total;
    const remainder = filled % 7 === 0 ? 0 : 7 - (filled % 7);
    for (let i = 1; i <= remainder; i++) {
      const cell = document.createElement('div');
      cell.className = 'db-cal-day db-other-month';
      cell.innerHTML = `<div class="db-day-num">${i}</div>`;
      grid.appendChild(cell);
    }
  }

  document.getElementById('db-cal-prev').addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    loadAndRender(viewYear, viewMonth);
  });
  document.getElementById('db-cal-next').addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    loadAndRender(viewYear, viewMonth);
  });

  loadAndRender(viewYear, viewMonth);
})();
</script>

<%- include('partials/footer') %>
