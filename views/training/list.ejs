<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2><i class="bi bi-calendar-check"></i> Sessions de Formation</h2>
      <% if (user.role !== 'admin' && user.role !== 'supervisor') { %>
        <p class="text-muted mb-0">
          <i class="bi bi-info-circle"></i> 
          Affichage des sessions qui vous sont assignées
        </p>
      <% } %>
    </div>
    <% if (user.role === 'admin' || user.role === 'supervisor') { %>
      <a href="/training/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle Session
      </a>
    <% } %>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-light">
            <tr>
              <th>Employé</th>
              <th>Formateur</th>
              <% if (user.role === 'admin') { %>
                <th>Assigné à</th>
              <% } %>
              <th>Poste</th>
              <th>Date début</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (sessions.length === 0) { %>
              <tr>
                <td colspan="<%= user.role === 'admin' ? 7 : 6 %>" class="text-center text-muted py-4">
                  <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                  <p class="mb-0 mt-2">
                    <% if (user.role === 'admin') { %>
                      Aucune session enregistrée
                    <% } else { %>
                      Aucune session ne vous est assignée pour le moment
                    <% } %>
                  </p>
                </td>
              </tr>
            <% } else { %>
              <% sessions.forEach(session => { %>
                <tr>
                  <td><strong><%= session.employee_name %></strong></td>
                  <td><%= session.trainer_name %></td>
                  <% if (user.role === 'admin') { %>
                    <td>
                      <% if (session.assigned_fullname || session.assigned_username) { %>
                        <span class="badge bg-info">
                          <i class="bi bi-person-check"></i>
                          <%= session.assigned_fullname || session.assigned_username %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">Non assigné</span>
                      <% } %>
                    </td>
                  <% } %>
                  <td><%= session.poste || '-' %></td>
                  <td><%= session.date_debut ? new Date(session.date_debut).toLocaleDateString('fr-CA') : '-' %></td>
                  <td>
                    <% if (session.statut === 'En cours') { %>
                      <span class="badge bg-primary">En cours</span>
                    <% } else if (session.statut === 'Terminée') { %>
                      <span class="badge bg-success">Terminée</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= session.statut %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/training/<%= session.id %>" class="btn btn-sm btn-info" title="Voir">
                      <i class="bi bi-eye"></i>
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
