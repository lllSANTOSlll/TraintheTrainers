<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="mb-4">
    <h2>
      <i class="bi bi-plus-circle"></i> Nouvelle Session de Formation
    </h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <form method="POST" action="<%= action %>">
            <div class="mb-3">
              <label for="trainer_id" class="form-label">Formateur *</label>
              <select class="form-select" id="trainer_id" name="trainer_id" required>
                <option value="">-- Sélectionnez un formateur --</option>
                <% trainers.forEach(trainer => { %>
                  <option value="<%= trainer.id %>" <%= session && session.trainer_id === trainer.id ? 'selected' : '' %>>
                    <%= trainer.nom_prenom %>
                  </option>
                <% }); %>
              </select>
              <div class="form-text">Seuls les formateurs validés sont affichés</div>
            </div>

            <div class="mb-3">
              <label for="employee_name" class="form-label">Nom de l'employé *</label>
              <input type="text" class="form-control" id="employee_name" name="employee_name" 
                     value="<%= session ? session.employee_name : '' %>" required>
            </div>

            <div class="mb-3">
              <label for="poste" class="form-label">Poste</label>
              <input type="text" class="form-control" id="poste" name="poste" 
                     value="<%= session ? session.poste || '' : '' %>"
                     placeholder="Ex: Water Spider, Opérateur, etc.">
            </div>

            <div class="mb-3">
              <label for="assigned_user_id" class="form-label">
                <i class="bi bi-person-check"></i> Assigner à un Utilisateur *
              </label>
              <select class="form-select" id="assigned_user_id" name="assigned_user_id" required>
                <option value="">-- Sélectionner un utilisateur --</option>
                <% if (typeof users !== 'undefined' && users) { %>
                  <% users.forEach(u => { %>
                    <option value="<%= u.id %>" 
                            <%= session && session.assigned_user_id === u.id ? 'selected' : '' %>>
                      <% if (u.role === 'trainer') { %>🎓<% } else { %>👤<% } %>
                      <%= u.full_name || u.username %>
                      (<%= u.role === 'trainer' ? 'Formateur' : 'User' %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
              <div class="form-text">
                <i class="bi bi-info-circle"></i>
                <strong>Important:</strong> Seul l'utilisateur assigné (et les admins) pourra voir cette session
              </div>
            </div>

            <div class="mb-3">
              <label for="template_id" class="form-label">
                <i class="bi bi-list-check"></i> Modèle de Checklist
              </label>
              <select class="form-select" id="template_id" name="template_id">
                <option value="">-- Aucun (vide) --</option>
                <% if (typeof templates !== 'undefined' && templates) { %>
                  <% templates.forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.title %></option>
                  <% }); %>
                <% } %>
              </select>
              <div class="form-text">
                Sélectionnez un modèle pour charger automatiquement la checklist.
                <a href="/checklists" target="_blank">Gérer les modèles</a>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="date_debut" class="form-label">Date de début</label>
                  <input type="date" class="form-control" id="date_debut" name="date_debut" 
                         value="<%= session ? session.date_debut || '' : '' %>">
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <label for="date_fin" class="form-label">Date de fin (prévue)</label>
                  <input type="date" class="form-control" id="date_fin" name="date_fin" 
                         value="<%= session ? session.date_fin || '' : '' %>">
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="statut" class="form-label">Statut</label>
              <select class="form-select" id="statut" name="statut">
                <option value="En cours" <%= session && session.statut === 'En cours' ? 'selected' : '' %>>
                  En cours
                </option>
                <option value="Terminée" <%= session && session.statut === 'Terminée' ? 'selected' : '' %>>
                  Terminée
                </option>
                <option value="Suspendue" <%= session && session.statut === 'Suspendue' ? 'selected' : '' %>>
                  Suspendue
                </option>
              </select>
            </div>

            <div class="mb-3">
              <label for="notes" class="form-label">Notes</label>
              <textarea class="form-control" id="notes" name="notes" rows="3"><%= session ? session.notes || '' : '' %></textarea>
            </div>

            <div class="d-flex justify-content-between">
              <a href="/training" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Créer la Session
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
