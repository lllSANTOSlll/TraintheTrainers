<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0"><i class="bi bi-file-earmark-word me-2" style="color:#2b579a;"></i>Templates Word</h2>
  <a href="/checklists" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Retour
  </a>
</div>

<div class="card">
  <div class="card-header fw-bold">
    <i class="bi bi-download me-2"></i>Télécharger un modèle de checklist
  </div>
  <div class="card-body">
    <p class="text-muted small mb-3">
      <i class="bi bi-info-circle me-1"></i>
      Téléchargez le modèle Word correspondant à votre poste, remplissez-le et importez-le dans l'application.
    </p>

    <% if (files.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-folder-x" style="font-size:3rem;"></i>
        <p class="mt-3">Aucun template disponible.</p>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% files.forEach(f => {
          // Make a friendly display name from filename
          const display = f.replace('Distech_Checklist_', '').replace('Template_Checklist_', '').replace('.docx', '').replace(/_/g, ' ');
        %>
        <div class="col-md-4 col-sm-6">
          <div class="card h-100 border" style="border-radius:8px;">
            <div class="card-body d-flex align-items-center gap-3 py-3">
              <i class="bi bi-file-earmark-word-fill" style="font-size:2.2rem; color:#2b579a; flex-shrink:0;"></i>
              <div class="flex-grow-1 min-width-0">
                <div class="fw-semibold" style="font-size:.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="<%= f %>">
                  <%= display %>
                </div>
                <div class="text-muted" style="font-size:.75rem;">Checklist Word (.docx)</div>
              </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
              <a href="/checklists/template-download?file=<%= encodeURIComponent(f) %>"
                 class="btn btn-sm btn-outline-primary w-100">
                <i class="bi bi-download me-1"></i>Télécharger
              </a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
