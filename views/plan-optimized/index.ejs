<%- include('../partials/header') %>

<style>
/* ── Grid ── */
.crit-table { border-collapse:collapse; width:100%; }
.crit-table th, .crit-table td { border:1px solid #dee2e6; padding:0; }
.crit-table thead th {
  background:var(--dc-navy); color:#fff; text-align:center;
  padding:8px 6px; font-size:0.8rem; font-weight:600;
}
.crit-table thead th.col-station { text-align:left; padding-left:12px; min-width:150px; }
.day-sub { display:block; font-size:0.68rem; opacity:0.75; font-weight:normal; }

.station-cell {
  padding:6px 10px; background:#f8f9fa;
  border-right:2px solid var(--dc-navy); min-width:150px;
}
.station-name { font-weight:600; font-size:0.85rem; color:var(--dc-navy); }
.station-type { font-size:0.7rem; color:#6b7280; }

/* ── Criticality dropdown cells ── */
.crit-cell { padding:4px; text-align:center; vertical-align:middle; }

.crit-select {
  width:100%; min-width:88px; padding:5px 6px; border-radius:6px;
  font-size:0.78rem; font-weight:700; cursor:pointer;
  border:2px solid #e5e7eb; text-align:center; text-align-last:center;
  transition: all 0.12s;
}
.crit-select:focus { outline:none; box-shadow:0 0 0 2px rgba(13,110,253,0.25); }
/* Colour by selected value */
.crit-select[data-crit=""]  { background:#f3f4f6; color:#9ca3af; border-color:#e5e7eb; }
.crit-select[data-crit="0"] { background:#1f2937; color:#fff;    border-color:#374151; }
.crit-select[data-crit="1"] { background:#dcfce7; color:#15803d; border-color:#86efac; }
.crit-select[data-crit="2"] { background:#dbeafe; color:#1d4ed8; border-color:#93c5fd; }
.crit-select[data-crit="3"] { background:#fef3c7; color:#92400e; border-color:#fcd34d; }
.crit-select[data-crit="4"] { background:#fee2e2; color:#dc2626; border-color:#fca5a5; }
.crit-select option { background:#fff; color:#111; font-weight:600; }

/* Group row */
.group-row td {
  background:#e9edf2; padding:3px 12px;
  font-size:0.72rem; font-weight:700; color:var(--dc-navy);
  text-transform:uppercase; letter-spacing:0.05em;
  border-bottom:1px solid #cdd3da;
}

/* Legend */
.legend-pill { display:inline-block; padding:3px 10px; border-radius:50px; font-size:0.75rem; font-weight:700; }
</style>

<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-0"><i class="bi bi-stars"></i> Criticité Semaine</h2>
      <div class="text-muted" style="font-size:0.82rem;">
        Définissez la criticité de chaque poste pour la semaine — visible dans <strong>Plan. par Poste</strong> en couleur
      </div>
    </div>
    <button type="submit" form="crit-form" class="btn btn-success">
      <i class="bi bi-check-circle"></i> Sauvegarder
    </button>
  </div>

  <!-- Week navigation -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/planification-optimisee?week=<%= prevWeek %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-chevron-left"></i> Semaine précédente
    </a>
    <strong><%= weekLabel %></strong>
    <a href="/planification-optimisee?week=<%= nextWeek %>" class="btn btn-outline-secondary btn-sm">
      Semaine suivante <i class="bi bi-chevron-right"></i>
    </a>
  </div>

  <!-- Legend -->
  <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
    <span class="text-muted" style="font-size:0.8rem; font-weight:600;">Niveaux :</span>
    <span class="legend-pill" style="background:#f3f4f6;color:#9ca3af;border:2px solid #e5e7eb;">— Non défini</span>
    <span class="legend-pill" style="background:#1f2937;color:#9ca3af;border:2px solid #374151;"><i class="bi bi-slash-circle me-1"></i>Arrêt</span>
    <span class="legend-pill" style="background:#dcfce7;color:#15803d;border:2px solid #86efac;">Faible</span>
    <span class="legend-pill" style="background:#dbeafe;color:#1d4ed8;border:2px solid #93c5fd;">Moyen</span>
    <span class="legend-pill" style="background:#fef3c7;color:#92400e;border:2px solid #fcd34d;">Élevé</span>
    <span class="legend-pill" style="background:#fee2e2;color:#dc2626;border:2px solid #fca5a5;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Critique</span>
  </div>

  <% if (message) { %>
    <div class="alert alert-success alert-dismissible fade show py-2">
      <i class="bi bi-check-circle"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (!stations.length) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> Aucun poste défini.
      <% if (canPerm('stations_edit')) { %><a href="/stations/new" class="alert-link">Créer des postes</a>.<% } %>
    </div>
  <% } else { %>

  <form id="crit-form" method="POST" action="/planification-optimisee/save">
    <input type="hidden" name="monday" value="<%= monday %>">

    <div class="card shadow-sm">
      <div class="card-body p-0" style="overflow-x:auto;">
        <table class="crit-table">
          <thead>
            <tr>
              <th class="col-station">Poste</th>
              <% dayISO.forEach(function(iso, i) { %>
                <th>
                  <%= DAYS[i] %>
                  <span class="day-sub"><%= iso.slice(5).replace('-','/') %></span>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <%
              const STATION_TYPES = {
                ip_vav:'IP VAV', ip_stat:'IP STAT', ip_ctrl_2:'IP CTRL 2',
                smartvue:'Smartvue', unitouch:'Unitouch', iom:'IOM',
                ip_303:'IP 303', test_1:'1 TEST', s1000:'S1000',
                ecbl_4_6:'ECBL 4/6', ecbl_2_3:'ECBL 2/3', ecbl_vav_s:'ECBL VAV/S',
                kit_demobox:'Kit Demobox', vavn_103:'103 VAVN', display:'Display',
                ecy_4_6:'ECY 4/6', ecbos:'ECBOS', resence:'Resence',
                horyzon:'Horyzon', ecy_2_3:'ECY 2/3', immersion:'Immersion'
              };
              let lastKey = null;
            %>
            <% stations.forEach(function(station) {
              const typeLabel = STATION_TYPES[station.station_key] || station.station_key;
              const stCrit = critMap[station.id] || {};
            %>
              <% if (station.station_key !== lastKey) { lastKey = station.station_key; %>
                <tr class="group-row">
                  <td colspan="<%= 1 + dayISO.length %>">
                    <i class="bi bi-grid-3x3-gap-fill me-1"></i><%= typeLabel %>
                  </td>
                </tr>
              <% } %>
              <tr>
                <td class="station-cell">
                  <div class="station-name"><%= station.name %></div>
                  <div class="station-type"><%= typeLabel %></div>
                </td>
                <% dayISO.forEach(function(iso) {
                  const val = stCrit[iso] !== undefined ? String(stCrit[iso]) : '';
                  const fieldName = 'crit_' + station.id + '_' + iso;
                %>
                  <td class="crit-cell">
                    <select name="<%= fieldName %>" class="crit-select" data-crit="<%= val %>"
                            onchange="this.dataset.crit = this.value">
                      <option value=""  <%= val === ''  ? 'selected' : '' %>>—</option>
                      <option value="1" <%= val === '1' ? 'selected' : '' %>>Faible</option>
                      <option value="2" <%= val === '2' ? 'selected' : '' %>>Moyen</option>
                      <option value="3" <%= val === '3' ? 'selected' : '' %>>Élevé</option>
                      <option value="4" <%= val === '4' ? 'selected' : '' %>>⚠ Critique</option>
                      <option value="0" <%= val === '0' ? 'selected' : '' %>>🚫 Arrêt</option>
                    </select>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
      <button type="submit" class="btn btn-success btn-lg">
        <i class="bi bi-check-circle"></i> Sauvegarder la semaine
      </button>
    </div>
  </form>

  <% } %>
</div>

<script>
// Bulk helper: set whole row or column quickly (optional convenience)
// Colour updates automatically via the onchange handler on each <select>.
</script>

<%- include('../partials/footer') %>
