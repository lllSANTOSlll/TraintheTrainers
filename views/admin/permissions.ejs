<%- include('../partials/header') %>

<style>
  .perm-table th, .perm-table td { vertical-align: middle; }
  .perm-table thead th { text-align: center; font-size: 0.85rem; }
  .perm-table td.action-label { font-size: 0.85rem; min-width: 220px; }
  .perm-table tr.group-header td { background: var(--dc-navy); color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 12px; }
  .form-check-input { width: 2.2em; height: 1.2em; cursor: pointer; }
  .form-check-input:checked { background-color: var(--dc-green, #62BB46); border-color: var(--dc-green, #62BB46); }
  .role-col { min-width: 90px; text-align: center; }
  .locked-on  { color: #62BB46; font-size: 1.1rem; }
  .locked-off { color: #ccc;    font-size: 1.1rem; }
  .role-header { font-size: 0.88rem; font-weight: 700; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h2 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Éditeur de Permissions</h2>
  <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Retour Utilisateurs
  </a>
</div>

<% if (message) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle me-1"></i><%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span><i class="bi bi-toggles me-2"></i>Permissions par Rôle</span>
    <span class="small opacity-75">Les permissions Admin (⭐) sont verrouillées et toujours actives</span>
  </div>
  <div class="card-body p-0">
    <form method="POST" action="/admin/permissions" id="perm-form">
      <div class="table-responsive">
        <table class="table perm-table mb-0">
          <thead>
            <tr>
              <th style="min-width:220px;">Action</th>
              <th class="role-col">👤<br><span class="role-header">User</span></th>
              <th class="role-col">🎓<br><span class="role-header">Formateur</span></th>
              <th class="role-col">👔<br><span class="role-header">Superviseur</span></th>
              <th class="role-col">⭐<br><span class="role-header">Admin</span></th>
            </tr>
          </thead>
          <tbody>
            <%
              const roles = ['user','trainer','supervisor','admin'];
              let lastGroup = '';
            %>
            <% labels.forEach(function(item) { %>
              <% if (item.group !== lastGroup) { lastGroup = item.group; %>
              <tr class="group-header">
                <td colspan="5"><%= item.group %></td>
              </tr>
              <% } %>
              <tr>
                <td class="action-label"><%= item.label %></td>
                <% roles.forEach(function(role) {
                  const isAdminRole   = role === 'admin';
                  const isAdminPerm   = item.key.startsWith('admin_');
                  const locked        = isAdminRole; // admin is always locked ON
                  const lockedOff     = false;       // nothing forced off
                  const checked       = permsData[role] && permsData[role][item.key] === 1;
                %>
                <td class="role-col">
                  <% if (locked) { %>
                    <!-- Admin: always ON, not editable -->
                    <input type="hidden" name="admin__<%= item.key %>" value="1">
                    <i class="bi bi-check-circle-fill locked-on" title="Toujours activé pour Admin"></i>
                  <% } else { %>
                    <div class="form-check form-switch d-flex justify-content-center">
                      <input class="form-check-input" type="checkbox"
                             name="<%= role %>__<%= item.key %>"
                             value="1"
                             <%= checked ? 'checked' : '' %>
                             id="<%= role %>_<%= item.key %>">
                    </div>
                  <% } %>
                </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="p-3 border-top d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" onclick="resetToDefaults()">
          <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser par défaut
        </button>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-save me-1"></i>Enregistrer les permissions
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// Default values for reset
const DEFAULTS = <%- JSON.stringify({
  user:       { employees_view:0, employees_edit:0, employees_import:0, matrix_view:0, schedule_view:0, sessions_view_own:1, sessions_view_all:0, sessions_checklist:1, sessions_create:0, checklists_edit:0, checklists_import:0, admin_delete:0, admin_users:0, admin_settings:0 },
  trainer:    { employees_view:0, employees_edit:0, employees_import:0, matrix_view:0, schedule_view:0, sessions_view_own:1, sessions_view_all:0, sessions_checklist:1, sessions_create:0, checklists_edit:0, checklists_import:0, admin_delete:0, admin_users:0, admin_settings:0 },
  supervisor: { employees_view:1, employees_edit:1, employees_import:1, matrix_view:1, schedule_view:1, sessions_view_own:1, sessions_view_all:1, sessions_checklist:1, sessions_create:1, checklists_edit:1, checklists_import:1, admin_delete:0, admin_users:0, admin_settings:0 },
}) %>;

function resetToDefaults() {
  if (!confirm('Réinitialiser toutes les permissions aux valeurs par défaut?')) return;
  ['user','trainer','supervisor'].forEach(role => {
    Object.entries(DEFAULTS[role]).forEach(([key, val]) => {
      const el = document.getElementById(role + '_' + key);
      if (el) el.checked = val === 1;
    });
  });
}
</script>

<%- include('../partials/footer') %>
