<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="mb-4">
    <h2><i class="bi bi-sliders"></i> Paramètres de l'Application</h2>
    <p class="text-muted">Configurez SharePoint et personnalisez l'apparence</p>
  </div>

  <% if (message) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row">
    <!-- SharePoint Configuration -->
    <div class="col-lg-6 mb-4">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-microsoft"></i> Configuration SharePoint</h5>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/settings/sharepoint">
            <div class="mb-3">
              <label for="sharepoint_client_id" class="form-label">
                <i class="bi bi-key"></i> Client ID
              </label>
              <input type="text" class="form-control" id="sharepoint_client_id" 
                     name="sharepoint_client_id" 
                     value="<%= settings.sharepoint_client_id || '' %>"
                     placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx">
              <div class="form-text">Application (client) ID de votre app Azure AD</div>
            </div>

            <div class="mb-3">
              <label for="sharepoint_client_secret" class="form-label">
                <i class="bi bi-shield-lock"></i> Client Secret
              </label>
              <input type="password" class="form-control" id="sharepoint_client_secret" 
                     name="sharepoint_client_secret" 
                     value="<%= settings.sharepoint_client_secret || '' %>"
                     placeholder="Votre secret client">
              <div class="form-text">Secret de l'application Azure AD</div>
            </div>

            <div class="mb-3">
              <label for="sharepoint_tenant_id" class="form-label">
                <i class="bi bi-building"></i> Tenant ID
              </label>
              <input type="text" class="form-control" id="sharepoint_tenant_id" 
                     name="sharepoint_tenant_id" 
                     value="<%= settings.sharepoint_tenant_id || '' %>"
                     placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx">
              <div class="form-text">Directory (tenant) ID de votre organisation</div>
            </div>

            <div class="mb-3">
              <label for="sharepoint_site_url" class="form-label">
                <i class="bi bi-link-45deg"></i> URL du Site SharePoint
              </label>
              <input type="text" class="form-control" id="sharepoint_site_url" 
                     name="sharepoint_site_url" 
                     value="<%= settings.sharepoint_site_url || '' %>"
                     placeholder="https://votrecompanie.sharepoint.com/sites/votresite">
              <div class="form-text">URL complète de votre site SharePoint</div>
            </div>

            <div class="mb-3">
              <label for="sharepoint_list_name" class="form-label">
                <i class="bi bi-list-ul"></i> Nom de la Liste
              </label>
              <input type="text" class="form-control" id="sharepoint_list_name" 
                     name="sharepoint_list_name" 
                     value="<%= settings.sharepoint_list_name || 'FormateursQualifies' %>">
              <div class="form-text">Nom exact de la liste SharePoint</div>
            </div>

            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save"></i> Enregistrer SharePoint
            </button>
          </form>

          <hr class="my-4">

          <div class="alert alert-info">
            <h6><i class="bi bi-info-circle"></i> Guide de configuration</h6>
            <ol class="mb-0 small">
              <li>Créez une app dans Azure AD (App registrations)</li>
              <li>Ajoutez les permissions: Sites.ReadWrite.All</li>
              <li>Créez un client secret</li>
              <li>Copiez Client ID, Secret et Tenant ID ici</li>
              <li>Créez la liste SharePoint avec les colonnes nécessaires</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Theme Configuration -->
    <div class="col-lg-6 mb-4">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="bi bi-palette"></i> Personnalisation du Thème</h5>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/settings/theme">
            <div class="mb-3">
              <label for="theme_primary_color" class="form-label">
                <i class="bi bi-circle-fill" style="color: <%= settings.theme_primary_color || '#0066cc' %>"></i> 
                Couleur Principale
              </label>
              <input type="color" class="form-control form-control-color" 
                     id="theme_primary_color" name="theme_primary_color" 
                     value="<%= settings.theme_primary_color || '#0066cc' %>">
            </div>

            <div class="mb-3">
              <label for="theme_sidebar_bg" class="form-label">
                <i class="bi bi-circle-fill" style="color: <%= settings.theme_sidebar_bg || '#2c3e50' %>"></i> 
                Couleur Barre Latérale
              </label>
              <input type="color" class="form-control form-control-color" 
                     id="theme_sidebar_bg" name="theme_sidebar_bg" 
                     value="<%= settings.theme_sidebar_bg || '#2c3e50' %>">
            </div>

            <div class="mb-3">
              <label for="theme_sidebar_hover" class="form-label">
                <i class="bi bi-circle-fill" style="color: <%= settings.theme_sidebar_hover || '#34495e' %>"></i> 
                Couleur Survol Menu
              </label>
              <input type="color" class="form-control form-control-color" 
                     id="theme_sidebar_hover" name="theme_sidebar_hover" 
                     value="<%= settings.theme_sidebar_hover || '#34495e' %>">
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="theme_success_color" class="form-label">
                  <i class="bi bi-circle-fill text-success"></i> Succès
                </label>
                <input type="color" class="form-control form-control-color" 
                       id="theme_success_color" name="theme_success_color" 
                       value="<%= settings.theme_success_color || '#28a745' %>">
              </div>

              <div class="col-md-6 mb-3">
                <label for="theme_danger_color" class="form-label">
                  <i class="bi bi-circle-fill text-danger"></i> Danger
                </label>
                <input type="color" class="form-control form-control-color" 
                       id="theme_danger_color" name="theme_danger_color" 
                       value="<%= settings.theme_danger_color || '#dc3545' %>">
              </div>

              <div class="col-md-6 mb-3">
                <label for="theme_warning_color" class="form-label">
                  <i class="bi bi-circle-fill text-warning"></i> Avertissement
                </label>
                <input type="color" class="form-control form-control-color" 
                       id="theme_warning_color" name="theme_warning_color" 
                       value="<%= settings.theme_warning_color || '#ffc107' %>">
              </div>

              <div class="col-md-6 mb-3">
                <label for="theme_info_color" class="form-label">
                  <i class="bi bi-circle-fill text-info"></i> Info
                </label>
                <input type="color" class="form-control form-control-color" 
                       id="theme_info_color" name="theme_info_color" 
                       value="<%= settings.theme_info_color || '#17a2b8' %>">
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <button type="submit" class="btn btn-info">
                <i class="bi bi-save"></i> Enregistrer Thème
              </button>
              
              <form method="POST" action="/admin/settings/reset" style="display: inline;">
                <input type="hidden" name="category" value="theme">
                <button type="submit" class="btn btn-outline-secondary"
                        onclick="return confirm('Réinitialiser le thème aux couleurs par défaut?')">
                  <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                </button>
              </form>
            </div>
          </form>

          <hr class="my-4">

          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Note:</strong> Les changements de thème nécessitent un rechargement de la page.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
