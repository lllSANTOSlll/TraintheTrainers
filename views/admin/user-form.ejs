<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="mb-4">
    <h2>
      <i class="bi <%= editUser ? 'bi-pencil' : 'bi-plus-circle' %>"></i>
      <%= editUser ? 'Modifier' : 'Nouvel' %> Utilisateur
    </h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card">
        <div class="card-body">
          <form method="POST" action="<%= action %>">
            <div class="mb-3">
              <label for="username" class="form-label">Nom d'utilisateur *</label>
              <input type="text" class="form-control" id="username" name="username" 
                     value="<%= editUser ? editUser.username : '' %>" required>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">
                Mot de passe <%= editUser ? '(laisser vide pour ne pas changer)' : '*' %>
              </label>
              <input type="password" class="form-control" id="password" name="password" 
                     <%= editUser ? '' : 'required' %>>
            </div>

            <div class="mb-3">
              <label for="full_name" class="form-label">Nom complet</label>
              <input type="text" class="form-control" id="full_name" name="full_name" 
                     value="<%= editUser ? editUser.full_name || '' : '' %>">
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" 
                     value="<%= editUser ? editUser.email || '' : '' %>">
            </div>

            <div class="mb-3" id="dept-field">
              <label for="department" class="form-label">Département</label>
              <select class="form-select" id="department" name="department">
                <option value="" <%= !editUser || !editUser.department ? 'selected' : '' %>>— Aucun (Admin uniquement) —</option>
                <option value="Operations"  <%= editUser && editUser.department === 'Operations'  ? 'selected' : '' %>>Opérations</option>
                <option value="Technicians" <%= editUser && editUser.department === 'Technicians' ? 'selected' : '' %>>Techniciens</option>
                <option value="Logistics"   <%= editUser && editUser.department === 'Logistics'   ? 'selected' : '' %>>Logistique</option>
              </select>
              <div class="form-text">Requis pour Superviseur, Formateur et Utilisateur. L'Admin n'a pas de département.</div>
            </div>

            <div class="mb-3">
              <label for="role" class="form-label">Rôle *</label>
              <select class="form-select" id="role" name="role" required onchange="updateRoleDescription()">
                <option value="user" <%= editUser && editUser.role === 'user' ? 'selected' : '' %>>
                  👤 Utilisateur (Opérateur/Technicien)
                </option>
                <option value="trainer" <%= editUser && editUser.role === 'trainer' ? 'selected' : '' %>>
                  🎓 Formateur (Trainer)
                </option>
                <option value="supervisor" <%= editUser && editUser.role === 'supervisor' ? 'selected' : '' %>>
                  👔 Superviseur
                </option>
                <option value="admin" <%= editUser && editUser.role === 'admin' ? 'selected' : '' %>>
                  ⭐ Administrateur
                </option>
              </select>
              <div class="form-text" id="role-description">
                <!-- Set by JavaScript -->
              </div>
            </div>

            <!-- Role permissions table -->
            <div class="card bg-light mb-3">
              <div class="card-body p-3">
                <h6 class="mb-2 d-flex align-items-center justify-content-between">
                  <span><i class="bi bi-shield-check"></i> Permissions par Rôle</span>
                  <a href="/admin/permissions" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil-square me-1"></i>Éditer les permissions
                  </a>
                </h6>
                <div class="table-responsive">
                  <table class="table table-sm mb-0" style="font-size: 0.85rem;">
                    <thead>
                      <tr>
                        <th>Action</th>
                        <th class="text-center">👤 User</th>
                        <th class="text-center">🎓 Formateur</th>
                        <th class="text-center">👔 Superviseur</th>
                        <th class="text-center">⭐ Admin</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr class="table-primary">
                        <td colspan="5" class="fw-bold small py-1" style="font-size:0.75rem;">EMPLOYÉS &amp; PLANIFICATION</td>
                      </tr>
                      <tr>
                        <td>Voir la liste des employés</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Ajouter / Modifier un employé</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Importer CSV employés</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Matrice de formation</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Planification hebdomadaire</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr class="table-secondary">
                        <td colspan="5" class="fw-bold small py-1" style="font-size:0.75rem;">SESSIONS DE FORMATION</td>
                      </tr>
                      <tr>
                        <td>Voir ses sessions assignées</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Voir TOUTES les sessions</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Cocher la checklist</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Créer sessions / assigner</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Créer / modifier modèles checklist</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Importer Word</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr class="table-warning">
                        <td colspan="5" class="fw-bold small py-1" style="font-size:0.75rem;">ADMINISTRATION</td>
                      </tr>
                      <tr>
                        <td>Supprimer modèles / sessions</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Gérer les utilisateurs</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                      <tr>
                        <td>Configuration SharePoint / Thème</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-danger">❌</td>
                        <td class="text-center text-success">✅</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <a href="/admin/users" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Enregistrer
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
function updateRoleDescription() {
  const role = document.getElementById('role').value;
  const deptField = document.getElementById('dept-field');
  const deptSelect = document.getElementById('department');
  const desc = document.getElementById('role-description');

  if (role === 'admin') {
    deptField.style.opacity = '0.4';
    deptField.style.pointerEvents = 'none';
    deptSelect.value = '';
  } else {
    deptField.style.opacity = '1';
    deptField.style.pointerEvents = 'auto';
  }

  const descriptions = {
    'user': '👤 <strong>Utilisateur</strong> - Voit uniquement les sessions qui lui sont assignées. Idéal pour: opérateurs, water spiders, techniciens.',
    'trainer': '🎓 <strong>Formateur</strong> - Voit uniquement les sessions qui lui sont assignées. Idéal pour: formateurs qui forment d\'autres employés.',
    'supervisor': '👔 <strong>Superviseur</strong> - Voit TOUTES les sessions, peut créer et assigner aux formateurs, gérer les modèles. Idéal pour: superviseurs, chef d\'équipe.',
    'admin': '⭐ <strong>Administrateur</strong> - Accès complet: gestion utilisateurs, suppressions, configuration. Idéal pour: managers, responsables formation.'
  };

  desc.innerHTML = descriptions[role] || '';
}

updateRoleDescription();
</script>
