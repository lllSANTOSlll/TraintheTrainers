<%- include('../partials/header') %>

<style>
  .hol-badge { font-size: 0.78rem; padding: 3px 9px; border-radius: 20px; font-weight: 600; }
  .hol-Congé       { background: #fff3e0; color: #e65100; border: 1px solid #ffcc80; }
  .hol-Maladie     { background: #fce4ec; color: #880e4f; border: 1px solid #f48fb1; }
  .hol-Férié       { background: #e8f5e9; color: #1b5e20; border: 1px solid #a5d6a7; }
  .hol-Formation   { background: #e3f2fd; color: #0d47a1; border: 1px solid #90caf9; }
  .hol-Autre       { background: #f3e5f5; color: #4a148c; border: 1px solid #ce93d8; }
  .emp-avatar { width:32px; height:32px; border-radius:50%; background:var(--dc-navy,#001743); color:#fff; font-size:0.8rem; display:inline-flex; align-items:center; justify-content:center; font-weight:700; flex-shrink:0; }
  .cal-grid { display:grid; grid-template-columns: 140px repeat(7,1fr); border: 1px solid #dee2e6; border-radius:8px; overflow:hidden; }
  .cal-header { background:#001743; color:#fff; font-size:0.75rem; font-weight:700; text-align:center; padding:6px 4px; }
  .cal-emp { background:#f8f9fa; font-size:0.78rem; padding:6px 8px; border-bottom:1px solid #eee; font-weight:600; border-right:1px solid #dee2e6; display:flex; align-items:center; gap:6px; }
  .cal-cell { padding:3px; border-bottom:1px solid #eee; border-right:1px solid #dee2e6; text-align:center; min-height:32px; }
  .cal-hol { background:#ff6b35; color:#fff; border-radius:4px; font-size:0.68rem; padding:2px 4px; display:block; }
  .today-col { background: #fffde7 !important; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h2 class="mb-0"><i class="bi bi-calendar-heart me-2"></i>Gestion des Congés</h2>
  <a href="/schedule" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Retour au planning
  </a>
</div>

<% if (message) { %>
  <div class="alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-circle me-1"></i><%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-triangle me-1"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">

  <!-- ── Add holiday form ─────────────────────────────────── -->
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header" style="background:#001743; color:#fff;">
        <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Ajouter une absence</h6>
      </div>
      <div class="card-body">
        <form method="POST" action="/schedule/holidays">

          <div class="mb-3">
            <label class="form-label fw-semibold">Employé *</label>
            <select name="employee_id" class="form-select" required>
              <option value="">— Sélectionner —</option>
              <% employees.forEach(emp => { %>
                <option value="<%= emp.id %>"><%= emp.nom %> <% if (emp.shift) { %>(<%= emp.shift %>)<% } %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Type d'absence *</label>
            <select name="type" class="form-select" required>
              <option value="Congé">🏖️ Congé (vacances)</option>
              <option value="Maladie">🤒 Maladie</option>
              <option value="Férié">🎉 Jour férié</option>
              <option value="Formation">📚 Formation externe</option>
              <option value="Autre">📋 Autre</option>
            </select>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">Date début *</label>
              <input type="date" name="date_start" class="form-control" required id="inp-start"
                     onchange="checkDates()">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Date fin *</label>
              <input type="date" name="date_end" class="form-control" required id="inp-end"
                     onchange="checkDates()">
            </div>
          </div>
          <div id="duration-hint" class="text-muted small mb-3" style="display:none;"></div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optionnel)</span></label>
            <input type="text" name="notes" class="form-control" placeholder="Ex: Voyage prévu, médecin…" maxlength="120">
          </div>

          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-check-circle me-1"></i>Enregistrer l'absence
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ── Upcoming / current holidays list ────────────────── -->
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center justify-content-between py-2">
        <span class="fw-bold"><i class="bi bi-list-ul me-1"></i>Absences enregistrées</span>
        <span class="badge bg-secondary"><%= holidays.length %> au total</span>
      </div>

      <% if (holidays.length === 0) { %>
        <div class="card-body text-center py-5 text-muted">
          <i class="bi bi-calendar-x" style="font-size:2.5rem;"></i>
          <p class="mt-3 mb-0">Aucune absence enregistrée.</p>
        </div>
      <% } else { %>
        <!-- Group by upcoming / past -->
        <%
          const today = new Date().toISOString().slice(0, 10);
          const upcoming = holidays.filter(h => h.date_end >= today);
          const past     = holidays.filter(h => h.date_end < today);

          function formatDateRange(h) {
            const opts = { day: 'numeric', month: 'short', year: 'numeric' };
            const s = new Date(h.date_start + 'T12:00:00').toLocaleDateString('fr-CA', opts);
            const e = new Date(h.date_end   + 'T12:00:00').toLocaleDateString('fr-CA', opts);
            return s === e ? s : `${s} → ${e}`;
          }

          function nbDays(h) {
            const ms = new Date(h.date_end + 'T12:00:00') - new Date(h.date_start + 'T12:00:00');
            return Math.round(ms / 86400000) + 1;
          }
        %>

        <% if (upcoming.length > 0) { %>
        <div class="card-body pb-0 pt-2">
          <p class="text-muted small fw-semibold mb-2"><i class="bi bi-calendar-check text-success me-1"></i>À venir / En cours (<%= upcoming.length %>)</p>
        </div>
        <div class="list-group list-group-flush">
          <% upcoming.forEach(h => { %>
          <div class="list-group-item d-flex align-items-center gap-3 py-2">
            <div class="emp-avatar"><%= h.employee_nom ? h.employee_nom[0].toUpperCase() : '?' %></div>
            <div class="flex-grow-1">
              <div class="fw-semibold"><%= h.employee_nom %></div>
              <div class="small text-muted"><%= formatDateRange(h) %> &nbsp;·&nbsp; <%= nbDays(h) %> jour<%= nbDays(h) > 1 ? 's' : '' %></div>
              <% if (h.notes) { %><div class="small text-muted fst-italic"><%= h.notes %></div><% } %>
            </div>
            <span class="hol-badge hol-<%= h.type %>"><%= h.type %></span>
            <form method="POST" action="/schedule/holidays/<%= h.id %>?_method=DELETE"
                  onsubmit="return confirm('Supprimer ce congé?')">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </div>
          <% }); %>
        </div>
        <% } %>

        <% if (past.length > 0) { %>
        <div class="card-body pb-0 pt-3">
          <p class="text-muted small fw-semibold mb-2"><i class="bi bi-clock-history text-muted me-1"></i>Passés (<%= past.length %>)</p>
        </div>
        <div class="list-group list-group-flush">
          <% past.slice(0, 10).forEach(h => { %>
          <div class="list-group-item d-flex align-items-center gap-3 py-2" style="opacity:0.65;">
            <div class="emp-avatar" style="background:#aaa;"><%= h.employee_nom ? h.employee_nom[0].toUpperCase() : '?' %></div>
            <div class="flex-grow-1">
              <div class="fw-semibold text-muted"><%= h.employee_nom %></div>
              <div class="small text-muted"><%= formatDateRange(h) %> &nbsp;·&nbsp; <%= nbDays(h) %> jour<%= nbDays(h) > 1 ? 's' : '' %></div>
              <% if (h.notes) { %><div class="small text-muted fst-italic"><%= h.notes %></div><% } %>
            </div>
            <span class="hol-badge hol-<%= h.type %>" style="opacity:0.7;"><%= h.type %></span>
            <form method="POST" action="/schedule/holidays/<%= h.id %>?_method=DELETE"
                  onsubmit="return confirm('Supprimer ce congé?')">
              <button type="submit" class="btn btn-sm btn-outline-danger btn-sm">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </div>
          <% }); %>
          <% if (past.length > 10) { %>
            <div class="list-group-item text-center text-muted small py-2">… et <%= past.length - 10 %> autres absences passées</div>
          <% } %>
        </div>
        <% } %>
      <% } %>
    </div>

    <!-- ── Legend ── -->
    <div class="d-flex flex-wrap gap-2 mt-3">
      <% [['Congé','🏖️'],['Maladie','🤒'],['Férié','🎉'],['Formation','📚'],['Autre','📋']].forEach(([t,ic]) => { %>
        <span class="hol-badge hol-<%= t %>"><%= ic %> <%= t %></span>
      <% }); %>
    </div>
  </div>
</div>

<script>
function checkDates() {
  const s = document.getElementById('inp-start').value;
  const e = document.getElementById('inp-end').value;
  const hint = document.getElementById('duration-hint');
  if (!s || !e) { hint.style.display = 'none'; return; }
  const ms = new Date(e + 'T12:00:00') - new Date(s + 'T12:00:00');
  const days = Math.round(ms / 86400000) + 1;
  if (days < 1) {
    hint.style.display = '';
    hint.textContent = '⚠️ La date de fin doit être après la date de début.';
    hint.className = 'text-danger small mb-3';
  } else {
    hint.style.display = '';
    hint.textContent = `📅 Durée : ${days} jour${days > 1 ? 's' : ''}`;
    hint.className = 'text-success small mb-3';
  }
}

// Default start to today
document.querySelector('[name="date_start"]').valueAsDate = new Date();
document.querySelector('[name="date_end"]').valueAsDate   = new Date();
checkDates();
</script>

<%- include('../partials/footer') %>
