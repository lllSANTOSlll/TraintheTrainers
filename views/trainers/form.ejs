<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="mb-4">
    <h2>
      <i class="bi <%= trainer ? 'bi-pencil' : 'bi-plus-circle' %>"></i>
      <%= trainer ? 'Modifier' : 'Nouveau' %> Formateur
    </h2>
  </div>

  <div class="card">
    <div class="card-body">
      <form method="POST" action="<%= action %>">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="nom_prenom" class="form-label">Nom et Prénom *</label>
              <input type="text" class="form-control" id="nom_prenom" name="nom_prenom" 
                     value="<%= trainer ? trainer.nom_prenom : '' %>" required>
            </div>
          </div>

          <div class="col-md-6">
            <div class="mb-3">
              <label for="poste_actuel" class="form-label">Poste actuel</label>
              <input type="text" class="form-control" id="poste_actuel" name="poste_actuel" 
                     value="<%= trainer ? trainer.poste_actuel || '' : '' %>">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="departement" class="form-label">Département</label>
              <input type="text" class="form-control" id="departement" name="departement" 
                     value="<%= trainer ? trainer.departement || '' : '' %>">
            </div>
          </div>

          <div class="col-md-6">
            <div class="mb-3">
              <label for="domaine_expertise" class="form-label">Domaine d'expertise</label>
              <input type="text" class="form-control" id="domaine_expertise" name="domaine_expertise" 
                     value="<%= trainer ? trainer.domaine_expertise || '' : '' %>">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="superviseur" class="form-label">Superviseur</label>
              <input type="text" class="form-control" id="superviseur" name="superviseur" 
                     value="<%= trainer ? trainer.superviseur || '' : '' %>">
            </div>
          </div>

          <div class="col-md-6">
            <div class="mb-3">
              <label for="statut_validation" class="form-label">Statut de validation</label>
              <select class="form-select" id="statut_validation" name="statut_validation">
                <option value="Non validé" <%= trainer && trainer.statut_validation === 'Non validé' ? 'selected' : '' %>>
                  Non validé
                </option>
                <option value="Validé" <%= trainer && trainer.statut_validation === 'Validé' ? 'selected' : '' %>>
                  Validé
                </option>
              </select>
            </div>
          </div>
        </div>

        <% if (trainer) { %>
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="date_formation" class="form-label">Date de formation</label>
              <input type="date" class="form-control" id="date_formation" name="date_formation" 
                     value="<%= trainer.date_formation || '' %>">
            </div>
          </div>

          <div class="col-md-6">
            <div class="mb-3">
              <label for="date_certification" class="form-label">Date de certification</label>
              <input type="date" class="form-control" id="date_certification" name="date_certification" 
                     value="<%= trainer.date_certification || '' %>">
            </div>
          </div>
        </div>
        <% } %>

        <div class="mb-3">
          <label for="commentaires" class="form-label">Commentaires</label>
          <textarea class="form-control" id="commentaires" name="commentaires" rows="3"><%= trainer ? trainer.commentaires || '' : '' %></textarea>
        </div>

        <div class="d-flex justify-content-between">
          <a href="/trainers" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
          </a>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Enregistrer
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
