<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
  <div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
      <div class="col-md-6 text-center">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 5rem;"></i>
        <h1 class="mt-4"><%= title %></h1>
        <p class="lead"><%= message %></p>
        <% if (error && error.status) { %>
          <p class="text-muted">Erreur <%= error.status %></p>
        <% } %>
        <a href="/dashboard" class="btn btn-primary mt-3">
          <i class="bi bi-house"></i> Retour au tableau de bord
        </a>
      </div>
    </div>
  </div>
</body>
</html>
