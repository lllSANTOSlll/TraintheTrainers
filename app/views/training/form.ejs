<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="mb-4">
    <h2>
      <% if (session && session.id) { %>
        <i class="bi bi-pencil-square"></i> Modifier la Session
      <% } else { %>
        <i class="bi bi-plus-circle"></i> Nouvelle Session de Formation
      <% } %>
    </h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <form method="POST" action="<%= action %>">
            <div class="mb-3">
              <label for="trainer_id" class="form-label">Formateur *</label>
              <select class="form-select" id="trainer_id" name="trainer_id" required>
                <option value="">-- Sélectionnez un formateur --</option>
                <% trainers.forEach(trainer => { %>
                  <option value="<%= trainer.id %>" <%= session && session.trainer_id === trainer.id ? 'selected' : '' %>>
                    <%= trainer.nom_prenom %>
                  </option>
                <% }); %>
              </select>
              <div class="form-text">Seuls les formateurs validés sont affichés</div>
            </div>

            <div class="mb-3 position-relative">
              <label for="employee_search" class="form-label">Nom de l'employé *</label>
              <input type="text" class="form-control" id="employee_search"
                     placeholder="Rechercher un employé..."
                     autocomplete="off">
              <input type="hidden" id="employee_name" name="employee_name"
                     value="<%= session ? session.employee_name : '' %>" required>
              <div id="employee_dropdown" class="list-group position-absolute w-100" style="z-index:1000;display:none;max-height:220px;overflow-y:auto;"></div>
              <% if (session && session.employee_name) { %>
                <div class="form-text text-success"><i class="bi bi-person-check"></i> Sélectionné: <strong><%= session.employee_name %></strong></div>
              <% } else { %>
                <div class="form-text">Tapez pour filtrer la liste des employés actifs</div>
              <% } %>
            </div>

            <div class="mb-3" id="superviseur-block" style="display:none;">
              <label class="form-label">Superviseur</label>
              <input type="text" class="form-control" id="superviseur_display" readonly
                     placeholder="Superviseur de l'employé">
            </div>

            <div class="mb-3">
              <label for="poste" class="form-label">Station / Poste</label>
              <select class="form-select" id="poste" name="poste">
                <option value="">— Sélectionner une station —</option>
              </select>
              <div class="form-text" id="poste-hint">Les stations marquées ✓ sont déjà maîtrisées par l'employé</div>
            </div>


            <div class="mb-3">
              <label for="template_id" class="form-label">
                <i class="bi bi-list-check"></i> Modèle de Checklist
              </label>
              <select class="form-select" id="template_id" name="template_id">
                <option value="">-- Aucun (vide) --</option>
                <% if (typeof templates !== 'undefined' && templates) { %>
                  <% templates.forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.title %></option>
                  <% }); %>
                <% } %>
              </select>
              <div class="form-text">
                Sélectionnez un modèle pour charger automatiquement la checklist.
                <a href="/checklists" target="_blank">Gérer les modèles</a>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="date_debut" class="form-label">Date de début</label>
                  <input type="date" class="form-control" id="date_debut" name="date_debut" 
                         value="<%= session ? session.date_debut || '' : '' %>">
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <label for="date_fin" class="form-label">Date de fin (prévue)</label>
                  <input type="date" class="form-control" id="date_fin" name="date_fin" 
                         value="<%= session ? session.date_fin || '' : '' %>">
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="statut" class="form-label">Statut</label>
              <select class="form-select" id="statut" name="statut">
                <option value="En cours" <%= session && session.statut === 'En cours' ? 'selected' : '' %>>
                  En cours
                </option>
                <option value="Terminée" <%= session && session.statut === 'Terminée' ? 'selected' : '' %>>
                  Terminée
                </option>
                <option value="Suspendue" <%= session && session.statut === 'Suspendue' ? 'selected' : '' %>>
                  Suspendue
                </option>
              </select>
            </div>

            <div class="mb-3">
              <label for="notes" class="form-label">Notes</label>
              <textarea class="form-control" id="notes" name="notes" rows="3"><%= session ? session.notes || '' : '' %></textarea>
            </div>

            <div class="d-flex justify-content-between">
              <a href="/training" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> <%= session && session.id ? 'Enregistrer les modifications' : 'Créer la Session' %>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const STATIONS = <%- JSON.stringify(typeof stations !== 'undefined' ? stations : []) %>;
  const employees = <%- JSON.stringify((typeof employees !== 'undefined' ? employees : []).map(e => {
    const obj = { id: e.id, nom: e.nom, equipe: e.equipe || '', dept: e.department || '', superviseur: e.superviseur || '', trained: [] };
    if (typeof stations !== 'undefined') {
      stations.forEach(s => { if ((e[s.key] || '').trim() === 'Oui') obj.trained.push({ key: s.key, label: s.label }); });
    }
    return obj;
  })) %>;

  const searchInput      = document.getElementById('employee_search');
  const hiddenInput      = document.getElementById('employee_name');
  const dropdown         = document.getElementById('employee_dropdown');
  const posteSelect      = document.getElementById('poste');
  const posteHint        = document.getElementById('poste-hint');
  const superviseurBlock = document.getElementById('superviseur-block');
  const superviseurInput = document.getElementById('superviseur_display');

  function showSuperviseur(emp) {
    if (emp && emp.superviseur) {
      superviseurInput.value = emp.superviseur;
      superviseurBlock.style.display = 'block';
    } else {
      superviseurInput.value = '';
      superviseurBlock.style.display = 'none';
    }
  }

  const currentPoste = <%- JSON.stringify(session && session.poste ? session.poste : '') %>;

  if (hiddenInput.value) searchInput.value = hiddenInput.value;

  function fillStations(emp, restorePoste) {
    posteSelect.innerHTML = '<option value="">— Sélectionner une station —</option>';
    const trainedKeys = emp ? emp.trained.map(t => t.key) : [];
    STATIONS.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s.label;
      opt.textContent = s.label + (trainedKeys.includes(s.key) ? ' ✓' : '');
      posteSelect.appendChild(opt);
    });
    if (emp) {
      posteHint.textContent = emp.trained.length + ' station(s) déjà formée(s) (✓) sur ' + STATIONS.length + ' pour ' + emp.nom;
    }
    if (restorePoste) posteSelect.value = restorePoste;
  }

  // On page load: if editing, match employee and restore previously saved poste + supervisor
  if (hiddenInput.value) {
    const foundEmp = employees.find(e => e.nom === hiddenInput.value) || null;
    fillStations(foundEmp, currentPoste);
    showSuperviseur(foundEmp);
  } else {
    fillStations(null, null);
  }

  searchInput.addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    dropdown.innerHTML = '';
    if (!q) { dropdown.style.display = 'none'; return; }
    const matches = employees.filter(e => e.nom.toLowerCase().includes(q)).slice(0, 20);
    if (matches.length === 0) { dropdown.style.display = 'none'; return; }
    matches.forEach(e => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'list-group-item list-group-item-action py-1';
      item.innerHTML = '<strong>' + e.nom + '</strong>'
        + (e.equipe ? ' <small class="text-muted">· ' + e.equipe + '</small>' : '')
        + (e.dept   ? ' <small class="text-muted">· ' + e.dept   + '</small>' : '')
        + (e.trained.length ? ' <span class="badge bg-success ms-1" style="font-size:0.65rem;">' + e.trained.length + ' stations ✓</span>' : '');
      item.addEventListener('click', function() {
        hiddenInput.value = e.nom;
        searchInput.value = e.nom;
        dropdown.style.display = 'none';
        fillStations(e, null);
        showSuperviseur(e);
      });
      dropdown.appendChild(item);
    });
    dropdown.style.display = 'block';
  });

  document.addEventListener('click', function(ev) {
    if (!searchInput.contains(ev.target) && !dropdown.contains(ev.target)) {
      dropdown.style.display = 'none';
    }
  });
})();
</script>

<%- include('../partials/footer') %>
