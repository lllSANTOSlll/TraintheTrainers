<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clipboard-data"></i> Évaluation</h2>
    <a href="/trainers" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Retour
    </a>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Grille d'Évaluation - Formateur Qualifié</h5>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-6">
              <h6>Formation</h6>
              <p><%= evaluation.formation %></p>

              <h6>Formateur</h6>
              <p><%= evaluation.nom_prenom %></p>
            </div>

            <div class="col-md-6">
              <h6>Date</h6>
              <p><%= evaluation.date_evaluation ? new Date(evaluation.date_evaluation).toLocaleDateString('fr-CA') : '-' %></p>

              <h6>Évaluateur</h6>
              <p><%= evaluation.evaluateur %></p>
            </div>
          </div>

          <hr>

          <h5 class="mb-3">Critères d'évaluation</h5>
          <p class="text-muted">Échelle: 1 = Insuffisant | 2 = À améliorer | 3 = Satisfaisant | 4 = Très bien | 5 = Excellent</p>

          <div class="table-responsive">
            <table class="table table-bordered">
              <thead class="table-light">
                <tr>
                  <th>Critère</th>
                  <th>Description</th>
                  <th width="100">Note</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Maîtrise technique</strong></td>
                  <td>Compréhension et application des concepts techniques</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.maitrise_technique %>/5</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Compétences pédagogiques</strong></td>
                  <td>Capacité à transmettre clairement les informations</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.competences_pedagogiques %>/5</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Communication</strong></td>
                  <td>Clarté, écoute et interaction avec les participants</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.communication %>/5</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Standards de qualité</strong></td>
                  <td>Respect des procédures, sécurité et normes internes</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.standards_qualite %>/5</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Engagement et autonomie</strong></td>
                  <td>Initiative et participation active</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.engagement_autonomie %>/5</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Capacité d'adaptation</strong></td>
                  <td>Réaction face aux situations imprévues</td>
                  <td class="text-center">
                    <span class="badge bg-primary fs-5"><%= evaluation.capacite_adaptation %>/5</span>
                  </td>
                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr>
                  <td colspan="2"><strong>Moyenne</strong></td>
                  <td class="text-center">
                    <% 
                      const moyenne = (
                        parseInt(evaluation.maitrise_technique) +
                        parseInt(evaluation.competences_pedagogiques) +
                        parseInt(evaluation.communication) +
                        parseInt(evaluation.standards_qualite) +
                        parseInt(evaluation.engagement_autonomie) +
                        parseInt(evaluation.capacite_adaptation)
                      ) / 6;
                    %>
                    <span class="badge bg-success fs-5"><%= moyenne.toFixed(1) %>/5</span>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <% if (evaluation.remarques_generales) { %>
            <hr>
            <h6>Remarques générales / Conclusion</h6>
            <p><%= evaluation.remarques_generales %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
