<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scanner Station</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      background: #001743;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', sans-serif;
      color: #fff;
    }
    .logo { margin-bottom: 48px; opacity: 0.85; }
    .logo img { height: 48px; }
    .card {
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 20px;
      padding: 48px 56px;
      text-align: center;
      width: 420px;
      max-width: 95vw;
      backdrop-filter: blur(6px);
    }
    .scan-icon { font-size: 3.5rem; color: #009ADA; margin-bottom: 16px; }
    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
    p { color: rgba(255,255,255,0.6); font-size: 0.95rem; margin-bottom: 32px; }
    .scan-input {
      width: 100%;
      padding: 16px 20px;
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-align: center;
      text-transform: uppercase;
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 12px;
      background: rgba(255,255,255,0.1);
      color: #fff;
      outline: none;
      transition: border-color .2s;
    }
    .scan-input::placeholder { color: rgba(255,255,255,0.35); font-size: 1rem; letter-spacing: 1px; text-transform: none; font-weight: 400; }
    .scan-input:focus { border-color: #009ADA; background: rgba(0,154,218,0.12); }
    .error-msg {
      margin-top: 16px; color: #ff6b6b; font-size: 0.9rem;
      background: rgba(255,107,107,0.1); border-radius: 8px; padding: 10px 16px;
    }
    .hint { margin-top: 20px; font-size: 0.78rem; color: rgba(255,255,255,0.3); }
    kbd { background: rgba(255,255,255,0.15); padding: 2px 6px; border-radius: 4px; }
    .admin-link { position: fixed; bottom: 16px; right: 20px; color: rgba(255,255,255,0.2); font-size: 0.75rem; text-decoration: none; }
    .admin-link:hover { color: rgba(255,255,255,0.5); }
  </style>
</head>
<body>

  <div class="logo">
    <img src="/images/logo.png" alt="Distech Controls" style="filter: brightness(0) invert(1);">
  </div>

  <div class="card">
    <div class="scan-icon"><i class="bi bi-upc-scan"></i></div>
    <h1>Scanner la station</h1>
    <p>Scannez le code QR ou entrez le code manuellement</p>

    <form id="scan-form">
      <input
        type="text"
        id="scan-input"
        class="scan-input"
        placeholder="Code station…"
        autofocus
        autocomplete="off"
        spellcheck="false">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-msg"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
      <% } %>
      <div class="hint">Appuyez sur <kbd>Entrée</kbd> pour afficher</div>
    </form>
  </div>

  <a href="/display" class="admin-link"><i class="bi bi-gear me-1"></i>Admin</a>

  <script>
    const input = document.getElementById('scan-input');

    document.getElementById('scan-form').addEventListener('submit', function(e) {
      e.preventDefault();
      const code = input.value.trim().toUpperCase();
      if (!code) return;

      // Open the station display page (full screen on this display)
      window.location.href = '/display/show/' + encodeURIComponent(code);
    });

    // Always keep focus on input
    document.addEventListener('click', () => input.focus());
    input.focus();
  </script>
</body>
</html>
