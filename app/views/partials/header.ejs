        sidebar_hover: 'save_sidebar_hover',
        navbar_bg:     'save_navbar_bg',
        navbar_border: 'save_navbar_border',
        navbar_text:   'save_navbar_text',
        page_bg:       'save_page_bg',
        card_header:   'save_card_header',
      };

      function switchTab(tab) {
        ['accent','sidebar','navbar','page'].forEach(t => {
          document.getElementById('panel-' + t).style.display = t === tab ? '' : 'none';
          const btn = document.getElementById('tab-' + t);
          btn.style.borderBottom = t === tab ? '2px solid var(--dc-blue)' : '2px solid transparent';
          btn.style.fontWeight   = t === tab ? '700' : '600';
        });
        _activeTab = tab;
      }

      function paletteClick(hex) {
        // Apply to the current active tab's first picker
        const panelId = 'panel-' + _activeTab;
        const firstPicker = document.querySelector('#' + panelId + ' input[type="color"]');
        if (firstPicker) {
          firstPicker.value = hex;
          const id = firstPicker.id.replace('qc_', '');
          livePreview(id, hex);
        }
      }

      function livePreview(id, hex) {
        document.getElementById('hex_' + id) && (document.getElementById('hex_' + id).textContent = hex);
        // Apply CSS var
        if (_cssMap[id]) document.documentElement.style.setProperty(_cssMap[id], hex);
        // Update save hidden input
        if (_saveMap[id]) {
          const el = document.getElementById(_saveMap[id]);
          if (el) el.value = hex;
        }
        // For accent, also update dept inputs + dot
        if (id === 'accent') {
          const dot = document.querySelector('.dropdown-toggle [style*="border-radius:50%"]');
          if (dot) dot.style.background = hex;
          if (_activeDept && _allDepts.includes(_activeDept)) {
            document.getElementById('save_' + _activeDept).value = hex;
          } else {
            _allDepts.forEach(d => { document.getElementById('save_' + d).value = hex; });
          }
        }
      }

      function saveAll() {
        document.getElementById('formUI').submit();
        // accent form submit after short delay to avoid double navigation
        setTimeout(() => document.getElementById('formAccent').submit(), 300);
      }

      function resetDefaults() {
        if (!confirm('Réinitialiser les couleurs Distech Controls par défaut?')) return;
        const defaults = {
          sidebar_bg:'#001743', sidebar_deep:'#001030', sidebar_hover:'#002570',
          navbar_bg:'#ffffff', navbar_border:'#001743', navbar_text:'#001743',
          page_bg:'#f4f6f8', card_header:'#001743', accent:'#009ADA'
        };
        Object.entries(defaults).forEach(([id, hex]) => {
          const el = document.getElementById('qc_' + id);
          if (el) { el.value = hex; livePreview(id, hex); }
        });
      }
      </script>
    </div>
  </nav>

  <!-- ── Mobile sidebar toggle script ─────────────────────── -->
  <script>
  (function() {
    const toggle  = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      sidebar.classList.add('mobile-open');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('mobile-open');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (toggle)  toggle.addEventListener('click', openSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);

    // Close sidebar when a nav link is tapped on mobile
    sidebar && sidebar.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) closeSidebar();
      });
    });
  })();
  </script>

  <script>
  // ── Save sidebar scroll on every scroll ───────────────────
  (function() {
    const nav = document.querySelector('.sidebar-nav');
    if (!nav) return;
    nav.addEventListener('scroll', () => {
      sessionStorage.setItem('sidebar_scroll', nav.scrollTop);
    });
  })();
  </script>

