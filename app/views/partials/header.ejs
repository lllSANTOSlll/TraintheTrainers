  <script>
  (function() {
    const MONTHS_FR = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
    const DOWS = ['L','M','M','J','V','S','D'];
    const HOL_ICON = { 'Congé':'🏖️','Maladie':'🤒','Férié':'🎉','Formation':'📚','Autre':'📋' };

    let cur = new Date();
    let viewYear  = cur.getFullYear();
    let viewMonth = cur.getMonth(); // 0-based
    let holidayMap = {}; // 'YYYY-MM-DD' -> [{employee_nom, type, notes}]

    function isoDate(y, m, d) {
      return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    }

    function loadHolidays(year, month) {
      const from = isoDate(year, month, 1);
      const lastDay = new Date(year, month+1, 0).getDate();
      const to   = isoDate(year, month, lastDay);
      fetch(`/api/holidays?from=${from}&to=${to}`)
        .then(r => r.ok ? r.json() : [])
        .then(data => {
          holidayMap = {};
          data.forEach(h => {
            // Expand each holiday into individual days within this month
            const start = new Date(h.date_start + 'T12:00:00');
            const end   = new Date(h.date_end   + 'T12:00:00');
            for (let d = new Date(start); d <= end; d.setDate(d.getDate()+1)) {
              const iso = d.toISOString().slice(0,10);
              if (!holidayMap[iso]) holidayMap[iso] = [];
              holidayMap[iso].push(h);
            }
          });
          renderCalendar(year, month);
        })
        .catch(() => renderCalendar(year, month));
    }

    function renderCalendar(year, month) {
      const label = document.getElementById('sc-month-label');
      if (label) label.textContent = MONTHS_FR[month] + ' ' + year;

      const grid  = document.getElementById('sc-grid');
      if (!grid) return;
      grid.innerHTML = '';

      // Day-of-week headers
      DOWS.forEach(d => {
        const el = document.createElement('div');
        el.className = 'sc-dow';
        el.textContent = d;
        grid.appendChild(el);
      });

      const todayISO = new Date().toISOString().slice(0,10);
      const firstDay = new Date(year, month, 1).getDay(); // 0=Sun
      const offset   = firstDay === 0 ? 6 : firstDay - 1; // Mon-first
      const totalDays = new Date(year, month+1, 0).getDate();

      // Empty cells before first day
      for (let i = 0; i < offset; i++) {
        const el = document.createElement('div');
        el.className = 'sc-day sc-empty';
        grid.appendChild(el);
      }

      // Day cells
      for (let d = 1; d <= totalDays; d++) {
        const iso = isoDate(year, month, d);
        const hols = holidayMap[iso] || [];
        const el = document.createElement('div');
        el.className = 'sc-day';
        if (iso === todayISO) el.classList.add('sc-today');
        if (hols.length > 0)  el.classList.add('sc-has-holiday');

        const dayNum = document.createElement('span');
        dayNum.textContent = d;
        el.appendChild(dayNum);

        if (hols.length > 0) {
          const dot = document.createElement('div');
          dot.className = 'sc-dot';
          el.appendChild(dot);

          el.addEventListener('mouseenter', (e) => showTooltip(e, hols, iso));
          el.addEventListener('mouseleave', hideTooltip);
          el.addEventListener('click', () => { window.location.href = '/schedule/holidays'; });
        }

        grid.appendChild(el);
      }
    }

    function showTooltip(e, hols, iso) {
      const tt = document.getElementById('sc-tooltip');
      if (!tt) return;
      const date = new Date(iso + 'T12:00:00').toLocaleDateString('fr-CA', { day:'numeric', month:'long' });
      let html = `<div style="font-weight:700; margin-bottom:4px; color:#ff6b35;">${date}</div>`;
      hols.forEach(h => {
        const icon = HOL_ICON[h.type] || '📋';
        html += `<div>${icon} <strong>${h.employee_nom}</strong> — ${h.type}</div>`;
        if (h.notes) html += `<div style="opacity:0.7; font-size:0.65rem; margin-left:14px;">${h.notes}</div>`;
      });
      tt.innerHTML = html;
      tt.style.display = 'block';
      posTooltip(e);
    }

    function posTooltip(e) {
      const tt = document.getElementById('sc-tooltip');
      if (!tt) return;
      const x = Math.min(e.clientX + 12, window.innerWidth  - 220);
      const y = Math.min(e.clientY + 12, window.innerHeight - 100);
      tt.style.left = x + 'px';
      tt.style.top  = y + 'px';
    }

    function hideTooltip() {
      const tt = document.getElementById('sc-tooltip');
      if (tt) tt.style.display = 'none';
    }

    document.getElementById('sc-prev').addEventListener('click', () => {
      viewMonth--;
      if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      loadHolidays(viewYear, viewMonth);
    });

    document.getElementById('sc-next').addEventListener('click', () => {
      viewMonth++;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      loadHolidays(viewYear, viewMonth);
    });

    // Initial load
    loadHolidays(viewYear, viewMonth);
  })();
  </script>

