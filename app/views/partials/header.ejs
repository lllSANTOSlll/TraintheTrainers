  <!-- ── Hover-to-expand sidebar (desktop only) ─────────── -->
  <script>
  (function() {
    var sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    var expandDelay, collapseDelay;

    sidebar.addEventListener('mouseenter', function() {
      if (window.innerWidth <= 768) return;
      clearTimeout(collapseDelay);
      expandDelay = setTimeout(function() {
        sidebar.classList.add('sb-expanded');
      }, 60);
    });

    sidebar.addEventListener('mouseleave', function() {
      if (window.innerWidth <= 768) return;
      clearTimeout(expandDelay);
      collapseDelay = setTimeout(function() {
        sidebar.classList.remove('sb-expanded');
      }, 220);
    });
  })();
  </script>

