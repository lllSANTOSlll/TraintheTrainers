<%- include('../partials/header') %>

<style>
  .matrix-wrap { overflow-x: auto; max-height: 75vh; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px; }
  .matrix-table { border-collapse: separate; border-spacing: 0; min-width: 100%; }
  .matrix-table thead th { position: sticky; top: 0; background: #f8f9fa; z-index: 3; white-space: nowrap; font-size: 0.78rem; font-weight: 700; padding: 8px 6px; border-bottom: 2px solid #dee2e6; }
  .matrix-table thead th.col-name { position: sticky; left: 0; z-index: 4; min-width: 160px; }
  .matrix-table thead th.col-shift { position: sticky; left: 160px; z-index: 4; min-width: 70px; }
  .matrix-table thead th.col-total { min-width: 60px; }
  .matrix-table td { font-size: 0.78rem; padding: 6px; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
  .col-name-td { position: sticky; left: 0; background: #fff; z-index: 2; min-width: 160px; font-weight: 600; white-space: nowrap; border-right: 1px solid #e9ecef; }
  .col-shift-td { position: sticky; left: 160px; background: #fff; z-index: 2; min-width: 70px; color: #666; font-size: 0.75rem; border-right: 1px solid #e9ecef; }
  .matrix-cell { text-align: center; min-width: 60px; }
  .c-oui    { background: #d4edda; color: #155724; font-weight: 700; }
  .c-form   { background: #fff3cd; color: #856404; }
  .c-revoir { background: #ffe5d0; color: #7d3c00; }
  .c-empty  { background: #f8f9fa; color: #adb5bd; }
  .legend-dot { display:inline-block; width:12px; height:12px; border-radius:2px; margin-right:4px; vertical-align:middle; }
  .station-th { writing-mode: vertical-rl; transform: rotate(180deg); min-width: 36px; max-width: 40px; text-align: center; padding: 8px 4px; font-size: 0.72rem; }
@media (max-width: 768px) {
  .matrix-wrap { max-height: none; }
  .station-th { font-size: 0.6rem; }
  .matrix-cell { min-width: 44px; font-size: 0.7rem; }
  .col-name { min-width: 110px; }
}
</style>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h2 class="mb-0"><i class="bi bi-grid-3x3 me-2"></i>Matrice de formation</h2>
  <div class="d-flex gap-2 flex-wrap">
    <form method="GET" action="/matrix" class="d-flex gap-2" id="matrix-filter-form">
      <select name="shift" id="mx-shift" class="form-select form-select-sm" style="max-width:130px" onchange="saveMatrix();this.form.submit()">
        <option value="" <%= filterShift === '' ? 'selected' : '' %>>Tous les shifts</option>
        <option value="Jour"  <%= filterShift === 'Jour'  ? 'selected' : '' %>>Jour</option>
        <option value="Soir"  <%= filterShift === 'Soir'  ? 'selected' : '' %>>Soir</option>
        <option value="Nuit"  <%= filterShift === 'Nuit'  ? 'selected' : '' %>>Nuit</option>
      </select>
      <select name="statut" id="mx-statut" class="form-select form-select-sm" style="max-width:130px" onchange="saveMatrix();this.form.submit()">
        <option value="Actif"   <%= filterStatut === 'Actif'   ? 'selected' : '' %>>Actifs</option>
        <option value=""        <%= filterStatut === ''        ? 'selected' : '' %>>Tous</option>
        <option value="Inactif" <%= filterStatut === 'Inactif' ? 'selected' : '' %>>Inactifs</option>
      </select>
    </form>
    <script>
      const STORE_MX = 'filters_matrix';
      function saveMatrix() {
        try { localStorage.setItem(STORE_MX, JSON.stringify({
          shift:  document.getElementById('mx-shift')?.value  || '',
          statut: document.getElementById('mx-statut')?.value || ''
        })); } catch(e) {}
      }
      // On load: if no URL params, restore from localStorage
      (function() {
        const params = new URLSearchParams(window.location.search);
        if (!params.has('shift') && !params.has('statut')) {
          try {
            const saved = JSON.parse(localStorage.getItem(STORE_MX) || '{}');
            if (saved.shift || saved.statut) {
              const url = new URL(window.location.href);
              if (saved.shift)  url.searchParams.set('shift',  saved.shift);
              if (saved.statut) url.searchParams.set('statut', saved.statut);
              window.location.replace(url.toString());
            }
          } catch(e) {}
        }
      })();
    </script>
  </div>
</div>

<!-- Legend -->
<div class="d-flex gap-3 mb-3 flex-wrap align-items-center small">
  <span class="text-muted fw-medium">Légende :</span>
  <span><span class="legend-dot" style="background:#d4edda;"></span>Formé ✓</span>
  <span><span class="legend-dot" style="background:#fff3cd;"></span>En formation ⚡</span>
  <span><span class="legend-dot" style="background:#ffe5d0;"></span>À revoir !</span>
  <span><span class="legend-dot" style="background:#f8f9fa; border:1px solid #dee2e6;"></span>Non formé</span>
</div>

<% if (employees.length === 0) { %>
  <div class="card text-center py-5">
    <div class="card-body">
      <i class="bi bi-grid-3x3" style="font-size:3rem; color:#ccc;"></i>
      <p class="text-muted mt-3 mb-3">Aucun employé trouvé. Importez vos employés d'abord.</p>
      <a href="/employees/import" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Importer CSV</a>
    </div>
  </div>
<% } else { %>
  <div class="matrix-wrap">
    <table class="matrix-table">
      <thead>
        <tr>
          <th class="col-name">Employé</th>
          <th class="col-shift">Shift</th>
          <th class="col-total text-center">Total</th>
          <% stations.forEach(s => { %>
            <th class="station-th text-center" title="<%= s.label %>"><%= s.label %></th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach(e => { %>
        <tr>
          <td class="col-name-td">
            <a href="/employees/<%= e.id %>" class="text-decoration-none"><%= e.nom %></a>
          </td>
          <td class="col-shift-td"><%= e.shift || '—' %></td>
          <td class="text-center"><span class="badge bg-primary rounded-pill"><%= e.nb_stations || 0 %></span></td>
          <% stations.forEach(s => {
            const val = (e[s.key] || '').trim();
            let cls = 'c-empty', txt = '—';
            if (val === 'Oui')              { cls = 'c-oui';    txt = '✓'; }
            else if (val.startsWith('Formation')) { cls = 'c-form';   txt = '⚡'; }
            else if (val === 'À revoir')    { cls = 'c-revoir'; txt = '!'; }
          %>
            <td class="matrix-cell <%= cls %>" title="<%= val || 'Non formé' %>"><%= txt %></td>
          <% }); %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Coverage summary -->
  <div class="card mt-4">
    <div class="card-header fw-bold"><i class="bi bi-bar-chart me-2"></i>Couverture par station</div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Station</th>
              <th class="text-center">Formés</th>
              <th class="text-center">Formation</th>
              <th class="text-center">À revoir</th>
              <th style="min-width:140px">Progression</th>
            </tr>
          </thead>
          <tbody>
            <% stations.forEach(s => {
              const total = employees.length;
              const oui  = employees.filter(e => (e[s.key]||'').trim() === 'Oui').length;
              const form = employees.filter(e => (e[s.key]||'').trim().startsWith('Formation')).length;
              const rev  = employees.filter(e => (e[s.key]||'').trim() === 'À revoir').length;
              const pct  = total ? Math.round(oui / total * 100) : 0;
            %>
            <tr>
              <td class="fw-medium"><%= s.label %></td>
              <td class="text-center"><span class="badge bg-success"><%= oui %></span></td>
              <td class="text-center"><span class="badge bg-warning text-dark"><%= form %></span></td>
              <td class="text-center"><span class="badge bg-danger"><%= rev %></span></td>
              <td>
                <div class="progress" style="height:6px">
                  <div class="progress-bar bg-success" style="width:<%= pct %>%" title="<%= pct %>%"></div>
                </div>
                <small class="text-muted"><%= pct %>% formés</small>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
