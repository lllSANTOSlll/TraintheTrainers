<%- include('../partials/header') %>

<style>
  .prev-table { border-collapse: collapse; min-width: 100%; font-size: 0.82rem; }
  .prev-table th, .prev-table td { border: 1px solid #dee2e6; padding: 5px 8px; vertical-align: middle; }
  .prev-table thead th { background: #f8f9fa; font-weight: 700; text-align: center; white-space: nowrap; }
  .col-emp { min-width: 150px; position: sticky; left: 0; background: #fff; z-index: 2; }
  .station-chip { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.78rem; font-weight: 600; background: #d1ecf1; color: #0c5460; }
  .station-chip.repos { background: #f8f9fa; color: #6c757d; font-weight: 400; font-style: italic; }
  .algo-card { cursor: pointer; border: 2px solid #dee2e6; transition: border-color 0.15s; }
  .algo-card.selected { border-color: var(--primary-color); background: #f0f7ff; }
  .algo-card:hover { border-color: #adb5bd; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h2 class="mb-0"><i class="bi bi-magic me-2"></i>Planification automatique</h2>
    <p class="text-muted small mb-0 mt-1">
      Génère le planning de <strong><%= targetWeekLabel %></strong>
      à partir de <strong><%= sourceWeekLabel %></strong>
    </p>
  </div>
  <a href="/schedule?week=<%= sourceWeek %>&shift=<%= filterShift %>" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i>Retour au planning
  </a>
</div>

<% if (employees.length === 0) { %>
  <div class="card text-center py-5">
    <div class="card-body">
      <i class="bi bi-calendar-x" style="font-size:3rem; color:#ccc;"></i>
      <p class="text-muted mt-3">Aucun employé actif trouvé.</p>
      <a href="/employees" class="btn btn-primary">Gérer les employés</a>
    </div>
  </div>
<% } else { %>

<!-- Algorithm selector -->
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="algo-card card selected" id="card-copy" onclick="selectAlgo('copy')">
      <div class="card-body d-flex gap-3 align-items-start">
        <div style="font-size:2rem; line-height:1;">📋</div>
        <div>
          <h6 class="mb-1">Copier la semaine actuelle</h6>
          <p class="text-muted small mb-0">
            Chaque employé garde la même station que cette semaine, jour pour jour.
            Idéal si le planning ne change pas.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="algo-card card" id="card-rotate" onclick="selectAlgo('rotate')">
      <div class="card-body d-flex gap-3 align-items-start">
        <div style="font-size:2rem; line-height:1;">🔄</div>
        <div>
          <h6 class="mb-1">Rotation des stations</h6>
          <p class="text-muted small mb-0">
            Chaque employé avance à la prochaine station qu'il maîtrise.
            Favorise la polyvalence et l'apprentissage.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Shift filter -->
<div class="d-flex gap-2 align-items-center mb-3">
  <label class="small fw-semibold mb-0">Filtrer par shift :</label>
  <select id="shift-filter" class="form-select form-select-sm" style="max-width:140px" onchange="applyShiftFilter()">
    <option value="" <%= filterShift === '' ? 'selected' : '' %>>Tous</option>
    <option value="Jour"  <%= filterShift === 'Jour'  ? 'selected' : '' %>>Jour</option>
    <option value="Soir"  <%= filterShift === 'Soir'  ? 'selected' : '' %>>Soir</option>
    <option value="Nuit"  <%= filterShift === 'Nuit'  ? 'selected' : '' %>>Nuit</option>
  </select>
  <span class="text-muted small">— <span id="emp-count"><%= employees.length %></span> employé(s) affiché(s)</span>
</div>

<!-- Preview table -->
<div class="card mb-4">
  <div class="card-header py-2 d-flex justify-content-between align-items-center">
    <span class="fw-semibold small">
      <i class="bi bi-eye me-1"></i>Aperçu — <span id="preview-label">Copier la semaine actuelle</span>
    </span>
    <span class="badge bg-info text-dark">Semaine du <%= dayDates[0] %> → <%= dayDates[4] %></span>
  </div>
  <div class="card-body p-0" style="overflow-x:auto;">
    <table class="prev-table" id="preview-table">
      <thead>
        <tr>
          <th class="col-emp">Employé</th>
          <th class="text-center" style="min-width:55px">Shift</th>
          <% for (let i = 0; i < days.length; i++) { %>
            <th class="text-center" style="min-width:110px">
              <div><%= dayLabels[i] %></div>
              <div class="fw-normal text-muted" style="font-size:0.7rem"><%= dayDates[i] %></div>
            </th>
          <% } %>
        </tr>
      </thead>
      <tbody id="preview-body">
        <!-- filled by JS -->
      </tbody>
    </table>
  </div>
</div>

<!-- Apply form -->
<form method="POST" action="/schedule/auto/apply">
  <input type="hidden" name="source_week"   value="<%= sourceWeek %>">
  <input type="hidden" name="target_week"   value="<%= targetWeek %>">
  <input type="hidden" name="shift"         value="<%= filterShift %>">
  <input type="hidden" name="employee_ids"  value="<%= employees.map(e => e.id).join(',') %>">
  <input type="hidden" name="algorithm"     id="algo-input" value="copy">
  <div class="d-flex justify-content-end gap-2">
    <a href="/schedule?week=<%= sourceWeek %>" class="btn btn-secondary">
      <i class="bi bi-x-circle me-1"></i>Annuler
    </a>
    <button type="submit" class="btn btn-success">
      <i class="bi bi-check-circle me-1"></i>Appliquer ce planning
    </button>
  </div>
</form>

<% } %>

<script>
const EMPLOYEES  = <%- JSON.stringify(employees.map(e => ({ id: e.id, nom: e.nom, shift: e.shift || '' }))) %>;
const DAYS       = <%- JSON.stringify(days) %>;
const DAY_LABELS = <%- JSON.stringify(dayLabels) %>;
const STATIONS_MAP = <%- JSON.stringify(Object.fromEntries(stations.map(s => [s.key, s.label]))) %>;
const COPY_PLAN   = <%- copyPlan %>;
const ROTATE_PLAN = <%- rotatePlan %>;

let currentAlgo = 'copy';
let currentShift = '<%= filterShift %>';

const ALGO_LABELS = {
  copy:   'Copier la semaine actuelle',
  rotate: 'Rotation des stations'
};

function selectAlgo(algo) {
  currentAlgo = algo;
  document.getElementById('algo-input').value = algo;
  document.getElementById('preview-label').textContent = ALGO_LABELS[algo];
  ['copy','rotate'].forEach(a => {
    document.getElementById('card-' + a).classList.toggle('selected', a === algo);
  });
  renderTable();
}

function applyShiftFilter() {
  currentShift = document.getElementById('shift-filter').value;
  renderTable();
}

function renderTable() {
  const plan = currentAlgo === 'copy' ? COPY_PLAN : ROTATE_PLAN;
  const tbody = document.getElementById('preview-body');
  const filtered = EMPLOYEES.filter(e => !currentShift || e.shift === currentShift);
  document.getElementById('emp-count').textContent = filtered.length;

  tbody.innerHTML = filtered.map(emp => {
    const dayData = plan[emp.id] || {};
    const dayCells = DAYS.map(d => {
      const val = dayData[d] || '';
      const label = val ? (STATIONS_MAP[val] || val) : '— Repos —';
      const cls   = val ? 'station-chip' : 'station-chip repos';
      return `<td class="text-center"><span class="${cls}">${label}</span></td>`;
    }).join('');
    return `<tr>
      <td class="col-emp fw-medium">${emp.nom}</td>
      <td class="text-center text-muted small">${emp.shift || '—'}</td>
      ${dayCells}
    </tr>`;
  }).join('');
}

// Initial render
renderTable();
</script>

<%- include('../partials/footer') %>
