<%- include('../partials/header') %>

<style>
.sp-table { border-collapse: collapse; width: 100%; table-layout: fixed; }
.sp-table th, .sp-table td { border: 1px solid #dee2e6; padding: 0; vertical-align: top; }
.sp-table thead th { background: var(--dc-navy); color: #fff; text-align: center; padding: 8px 4px; font-size: 0.82rem; }
.sp-table thead th.col-station { text-align: left; padding-left: 12px; width: 160px; }
.sp-table .day-header-date { display: block; font-weight: normal; font-size: 0.72rem; opacity: 0.75; }

.sp-table .station-name-cell {
  padding: 0;
  border-right: 2px solid var(--dc-navy);
}
.station-label {
  padding: 6px 10px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--dc-navy);
  line-height: 1.3;
}
.station-type-badge {
  display: inline-block;
  font-size: 0.68rem;
  background: #e3ecf7;
  color: var(--dc-navy);
  border-radius: 4px;
  padding: 1px 5px;
  margin-top: 2px;
}

/* Shift-themed header colours */
.shift-jour  .station-name-cell { background: #fffbeb; }
.shift-jour thead th             { background: #b45309; }
.shift-soir  .station-name-cell { background: #eef2ff; }
.shift-soir thead th             { background: #1e3a8a; }

/* Criticality cell colours */
.crit-bg-0 { background: #1f2937 !important; }   /* Arrêt    — dark */
.crit-bg-1 { background: #dcfce7 !important; }   /* Faible   — green */
.crit-bg-2 { background: #dbeafe !important; }   /* Moyen    — blue */
.crit-bg-3 { background: #fef3c7 !important; }   /* Élevé    — orange */
.crit-bg-4 { background: #fee2e2 !important; }   /* Critique — red */

.crit-tag {
  display:block; text-align:center; font-size:0.6rem; font-weight:700;
  padding:1px 0 2px; letter-spacing:0.04em; opacity:0.75;
}
.crit-bg-0 .crit-tag { color:#9ca3af; }
.crit-bg-1 .crit-tag { color:#15803d; }
.crit-bg-2 .crit-tag { color:#1d4ed8; }
.crit-bg-3 .crit-tag { color:#92400e; }
.crit-bg-4 .crit-tag { color:#dc2626; }

.slot-cell { padding: 3px; }
.slot-select {
  width: 100%;
  font-size: 0.75rem;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  padding: 3px 4px;
  background: #fff;
  color: #333;
  margin-bottom: 2px;
}
.slot-select:last-child { margin-bottom: 0; }
.slot-select.filled { background: #e8f4fd; border-color: var(--dc-blue); font-weight: 600; color: var(--dc-navy); }

.type-group-row td {
  background: #e9edf2;
  padding: 4px 12px;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--dc-navy);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-bottom: 1px solid #cdd3da;
}

.shift-pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 18px; border-radius: 50px; font-weight: 600;
  font-size: 0.9rem; cursor: pointer; border: 2px solid transparent;
  transition: all 0.15s;
}
.shift-pill.jour  { background: #fef3c7; color: #92400e; border-color: #d97706; }
.shift-pill.jour.active  { background: #d97706; color: #fff; }
.shift-pill.soir  { background: #e0e7ff; color: #1e3a8a; border-color: #4f46e5; }
.shift-pill.soir.active  { background: #4f46e5; color: #fff; }
</style>

<div class="container-fluid">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">
      <i class="bi bi-layout-three-columns"></i> Planification par Poste
    </h2>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/planification-optimisee?week=<%= monday %>" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-stars"></i> Criticité Semaine
      </a>
      <!-- Auto-plan button -->
      <button type="button" class="btn btn-warning btn-sm" onclick="document.getElementById('auto-form').submit()">
        <i class="bi bi-magic"></i> Auto-Planifier
      </button>
      <!-- Clear week button -->
      <button type="button" class="btn btn-danger btn-sm" onclick="clearWeekConfirm()">
        <i class="bi bi-trash3"></i> Effacer Semaine
      </button>
      <!-- Vue par Opérateur masquée (standby): <a href="/schedule">Vue par Opérateur</a> -->
      <button type="submit" form="sp-form" class="btn btn-success btn-sm">
        <i class="bi bi-check-circle"></i> Enregistrer
      </button>
    </div>
  </div>

  <!-- Hidden auto-plan form -->
  <form id="auto-form" method="POST" action="/planification-postes/auto"
        onsubmit="return confirm('Générer automatiquement le planning pour la semaine ?\n\nCeci remplacera les assignations existantes pour le quart ' + '<%= shift %>' + '.\n\nBasé sur : criticité de la semaine + productivité du mois précédent.')">
    <input type="hidden" name="week_start" value="<%= monday %>">
    <input type="hidden" name="shift"      value="<%= shift %>">
  </form>

  <!-- Hidden clear-week form -->
  <form id="clear-form" method="POST" action="/planification-postes/clear">
    <input type="hidden" name="week_start" value="<%= monday %>">
    <input type="hidden" name="shift"      value="<%= shift %>">
  </form>
  <!-- Criticality legend -->
  <div class="d-flex gap-2 align-items-center mb-2 flex-wrap" style="font-size:0.75rem;">
    <span class="text-muted fw-semibold">Criticité :</span>
    <span style="background:#dcfce7;color:#15803d;padding:2px 8px;border-radius:50px;font-weight:700;">Faible</span>
    <span style="background:#dbeafe;color:#1d4ed8;padding:2px 8px;border-radius:50px;font-weight:700;">Moyen</span>
    <span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:50px;font-weight:700;">Élevé</span>
    <span style="background:#fee2e2;color:#dc2626;padding:2px 8px;border-radius:50px;font-weight:700;">⚠ Critique</span>
    <span style="background:#1f2937;color:#9ca3af;padding:2px 8px;border-radius:50px;font-weight:700;">🚫 Arrêt</span>
    <span class="text-muted ms-2">— Défini dans <a href="/planification-optimisee?week=<%= monday %>">Plan. Optimisée</a></span>
  </div>

  <!-- Shift filter -->
  <div class="d-flex align-items-center gap-3 mb-3">
    <span class="text-muted fw-semibold" style="font-size:0.85rem;">Quart :</span>
    <a href="/planification-postes?week=<%= monday %>&shift=Jour"
       class="shift-pill jour <%= shift === 'Jour' ? 'active' : '' %>">
      <i class="bi bi-sun-fill"></i> Jour
    </a>
    <a href="/planification-postes?week=<%= monday %>&shift=Soir"
       class="shift-pill soir <%= shift === 'Soir' ? 'active' : '' %>">
      <i class="bi bi-moon-stars-fill"></i> Soir
    </a>
    <span class="text-muted" style="font-size:0.8rem;">
      — planification indépendante par quart
    </span>
  </div>

  <% if (message) { %>
    <div class="alert alert-success alert-dismissible fade show py-2">
      <i class="bi bi-check-circle"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Week navigation -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/planification-postes?week=<%= prevWeek %>&shift=<%= shift %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-chevron-left"></i> Semaine précédente
    </a>
    <strong><%= weekLabel %></strong>
    <a href="/planification-postes?week=<%= nextWeek %>&shift=<%= shift %>" class="btn btn-outline-secondary btn-sm">
      Semaine suivante <i class="bi bi-chevron-right"></i>
    </a>
  </div>

  <% if (!stations.length) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i>
      Aucun poste défini pour ce département.
      <% if (canPerm('stations_edit')) { %>
        <a href="/stations/new" class="alert-link">Créer des postes de travail</a> d'abord.
      <% } %>
    </div>
  <% } else { %>

  <form id="sp-form" method="POST" action="/planification-postes/save">
    <input type="hidden" name="week_start"   value="<%= monday %>">
    <input type="hidden" name="shift"         value="<%= shift %>">
    <input type="hidden" name="assignments"   id="assignments-input">

    <div class="card shadow-sm">
      <div class="card-body p-0" style="overflow-x:auto;">
        <table class="sp-table shift-<%= shift.toLowerCase() %>">
          <thead>
            <tr>
              <th class="col-station">
                Poste
                <span style="display:block; font-size:0.7rem; font-weight:normal; opacity:0.8; margin-top:2px;">
                  <% if (shift === 'Jour') { %><i class="bi bi-sun-fill"></i> Quart de Jour
                  <% } else { %><i class="bi bi-moon-stars-fill"></i> Quart de Soir<% } %>
                </span>
              </th>
              <% DAYS.forEach(function(day, i) { %>
                <th>
                  <%= day %>
                  <span class="day-header-date"><%= dayDates[i] %></span>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <%
              const STATION_TYPES = {
                ip_vav:'IP VAV', ip_stat:'IP STAT', ip_ctrl_2:'IP CTRL 2',
                smartvue:'Smartvue', unitouch:'Unitouch', iom:'IOM',
                ip_303:'IP 303', test_1:'1 TEST', s1000:'S1000',
                ecbl_4_6:'ECBL 4/6', ecbl_2_3:'ECBL 2/3', ecbl_vav_s:'ECBL VAV/S',
                kit_demobox:'Kit Demobox', vavn_103:'103 VAVN', display:'Display',
                ecy_4_6:'ECY 4/6', ecbos:'ECBOS', resence:'Resence',
                horyzon:'Horyzon', ecy_2_3:'ECY 2/3', immersion:'Immersion'
              };
              let lastKey = null;
            %>
            <% stations.forEach(function(station) {
              const typeLabel    = STATION_TYPES[station.station_key] || station.station_key;
              const stationAssign = assignments[station.id] || {};
              const qualifiedEmps = employeesByKey[station.station_key] || [];
            %>
              <% if (station.station_key !== lastKey) { lastKey = station.station_key; %>
              <tr class="type-group-row">
                <td colspan="<%= 1 + DAYS.length %>">
                  <i class="bi bi-grid-3x3-gap-fill me-1"></i><%= typeLabel %>
                  <span class="text-muted fw-normal ms-2" style="text-transform:none; font-size:0.7rem;">
                    (<%= qualifiedEmps.length %> op. formé(s) — quart <%= shift %> — productivité de <%= typeof prodMonth !== 'undefined' ? prodMonth : 'mois préc.' %>)
                  </span>
                </td>
              </tr>
              <% } %>

              <tr>
                <td class="station-name-cell">
                  <div class="station-label">
                    <%= station.name %>
                    <div>
                      <span class="station-type-badge"><%= station.max_operators %> op. max</span>
                    </div>
                  </div>
                </td>
                <% for (let d = 0; d < 7; d++) {
                  const dayAssign = stationAssign[d] || {};
                  const iso = dayISO ? dayISO[d] : null;
                  const crit = (iso && critMap && critMap[station.id]) ? critMap[station.id][iso] : undefined;
                  const critClass = crit !== undefined ? 'crit-bg-' + crit : '';
                  const critLabel = crit === 0 ? 'ARRÊT' : crit === 1 ? 'FAIBLE' : crit === 2 ? 'MOYEN' : crit === 3 ? 'ÉLEVÉ' : crit === 4 ? '⚠ CRITIQUE' : '';
                %>
                  <td class="slot-cell <%= critClass %>">
                    <% if (critLabel) { %><span class="crit-tag"><%= critLabel %></span><% } %>
                    <% if (crit === 0) { %>
                      <div style="text-align:center; padding:6px 0; font-size:0.72rem; color:#6b7280;">
                        <i class="bi bi-slash-circle"></i> Non actif
                      </div>
                    <% } else { %>
                      <% for (let s = 0; s < station.max_operators; s++) {
                        const val = dayAssign[s] || '';
                        const key = station.id + '_' + d + '_' + s;
                      %>
                        <select class="slot-select <%= val ? 'filled' : '' %>"
                                data-key="<%= key %>"
                                onchange="syncDayConflicts(this)">
                          <option value="">—</option>
                          <% qualifiedEmps.forEach(function(emp) { %>
                            <option value="<%= emp.nom %>" <%= val === emp.nom ? 'selected' : '' %>>
                              <%= emp.nom %><% if (emp.prodScore !== null) { %> — <%= emp.prodScore %>%<% } %>
                            </option>
                          <% }); %>
                        </select>
                      <% } %>
                      <% if (qualifiedEmps.length === 0) { %>
                        <span class="text-muted" style="font-size:0.7rem; padding:3px;">Aucun</span>
                      <% } %>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
      <button type="submit" class="btn btn-success">
        <i class="bi bi-check-circle"></i> Enregistrer — Quart <%= shift %>
      </button>
    </div>
  </form>

  <% } %>
</div>

<script>
function clearWeekConfirm() {
  if (confirm('Êtes-vous certain de vouloir effacer TOUTES les assignations de cette semaine ?\n\nQuart : <%= shift %>\nSemaine du <%= monday %>\n\nCette action ne peut pas être annulée.')) {
    document.getElementById('clear-form').submit();
  }
}

function markFilled(sel) {
  sel.classList.toggle('filled', sel.value !== '');
}

// ── Conflict detection per day column ────────────────────────────────────────
// key format: stationId_dayIndex_slotIndex  →  parts[1] = dayIndex

function syncDayConflicts(changedSel) {
  markFilled(changedSel);

  const dayIdx = changedSel.dataset.key.split('_')[1];

  // All selects for this day column
  const daySels = Array.from(document.querySelectorAll('.slot-select'))
    .filter(s => s.dataset.key.split('_')[1] === dayIdx);

  // Build taken map
  const takenBy = {};
  daySels.forEach(s => {
    if (s.value) {
      if (!takenBy[s.value]) takenBy[s.value] = [];
      takenBy[s.value].push(s);
    }
  });

  daySels.forEach(s => {
    Array.from(s.options).forEach(opt => {
      if (!opt.value) { opt.disabled = false; opt.style.color = ''; return; }
      const takenElsewhere = takenBy[opt.value] && takenBy[opt.value].some(x => x !== s);
      opt.disabled    = takenElsewhere;
      opt.style.color = takenElsewhere ? '#9ca3af' : '';
      opt.textContent = opt.textContent.replace(/\s*⛔.*$/, '').trimEnd()
                      + (takenElsewhere ? ' ⛔' : '');
    });
    const conflict = s.value && takenBy[s.value] && takenBy[s.value].length > 1;
    s.style.borderColor = conflict ? '#dc2626' : '';
    s.title = conflict ? '⚠️ Opérateur déjà assigné ce jour!' : '';
  });
}

// Init conflict state on page load for all days
function initConflicts() {
  // Process each day separately
  const days = new Set(
    Array.from(document.querySelectorAll('.slot-select')).map(s => s.dataset.key.split('_')[1])
  );
  days.forEach(dayIdx => {
    const fakeSel = document.querySelector(`.slot-select[data-key$="_${dayIdx}_0"]`) ||
                   document.querySelector(`.slot-select[data-key*="_${dayIdx}_"]`);
    if (fakeSel) syncDayConflicts(fakeSel);
  });
}

document.getElementById('sp-form').addEventListener('submit', function(e) {
  // Check all days for conflicts before saving
  const days = {};
  document.querySelectorAll('.slot-select').forEach(s => {
    if (!s.value) return;
    const dayIdx = s.dataset.key.split('_')[1];
    if (!days[dayIdx]) days[dayIdx] = {};
    if (days[dayIdx][s.value]) {
      e.preventDefault();
      alert('⚠️ Conflit détecté !\n\n"' + s.value + '" est assigné à plusieurs postes le même jour.\n\nCorrigez avant d\'enregistrer.');
      return;
    }
    days[dayIdx][s.value] = true;
  });

  if (e.defaultPrevented) return;

  // Collect data normally
  const data = {};
  document.querySelectorAll('.slot-select').forEach(sel => {
    if (sel.value) data[sel.dataset.key] = sel.value;
  });
  document.getElementById('assignments-input').value = JSON.stringify(data);
});

// Init conflict highlighting on page load
initConflicts();
</script>

<%- include('../partials/footer') %>
