<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-grid-3x3-gap"></i> Postes de travail</h2>
    <% if (canPerm('stations_edit')) { %>
      <a href="/stations/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau Poste
      </a>
    <% } %>
  </div>

  <% if (message) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <i class="bi bi-check-circle"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (stations.length === 0) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i>
      <strong>Aucun poste défini.</strong>
      <% if (canPerm('stations_edit')) { %>
        Cliquez sur <strong>Nouveau Poste</strong> pour commencer.
      <% } %>
    </div>
  <% } else { %>

    <%
      // Build summary counts
      const totalStations = stations.length;
      const totalCapacity = stations.reduce((s, p) => s + (p.max_operators || 1), 0);
      const typeCount = Object.keys(grouped).length;
    %>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="fs-2 fw-bold text-primary"><%= totalStations %></div>
            <div class="text-muted small">Postes physiques</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="fs-2 fw-bold text-success"><%= totalCapacity %></div>
            <div class="text-muted small">Capacité totale (opérateurs)</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="fs-2 fw-bold" style="color:var(--dc-blue)"><%= typeCount %></div>
            <div class="text-muted small">Types de stations</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Table grouped by station type -->
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead style="background:var(--dc-navy); color:white;">
            <tr>
              <th class="px-3 py-2">Nom du poste</th>
              <th class="py-2">Type de station</th>
              <th class="py-2 text-center">Opérateurs max</th>
              <% if (user.role === 'admin') { %>
                <th class="py-2">Département</th>
              <% } %>
              <% if (canPerm('stations_edit')) { %>
                <th class="py-2 text-end pe-3">Actions</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% let prevType = null; %>
            <% stations.forEach(function(s) {
              const typeLabel = Object.keys(grouped).find(k => grouped[k].some(x => x.id === s.id)) || s.station_key;
              const isNewType = typeLabel !== prevType;
              prevType = typeLabel;
            %>
              <% if (isNewType) { %>
                <tr style="background:#f0f4f8;">
                  <td colspan="<%= 3 + (user.role === 'admin' ? 1 : 0) + (canPerm('stations_edit') ? 1 : 0) %>"
                      class="px-3 py-1">
                    <span class="badge" style="background:var(--dc-navy); font-size:0.8rem;">
                      <i class="bi bi-grid-3x3-gap-fill me-1"></i><%= typeLabel %>
                    </span>
                    <span class="text-muted small ms-2"><%= grouped[typeLabel].length %> poste(s)</span>
                  </td>
                </tr>
              <% } %>
              <tr>
                <td class="px-3 py-2 fw-semibold"><%= s.name %></td>
                <td class="py-2 text-muted"><%= typeLabel %></td>
                <td class="py-2 text-center">
                  <% for (let i = 0; i < s.max_operators; i++) { %>
                    <i class="bi bi-person-fill" style="color:var(--dc-blue); font-size:1rem;"></i>
                  <% } %>
                  <span class="ms-1 text-muted small"><%= s.max_operators %></span>
                </td>
                <% if (user.role === 'admin') { %>
                  <td class="py-2 text-muted small"><%= s.department || '—' %></td>
                <% } %>
                <% if (canPerm('stations_edit')) { %>
                  <td class="py-2 text-end pe-3">
                    <a href="/stations/<%= s.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form method="POST" action="/stations/<%= s.id %>?_method=DELETE"
                          style="display:inline;"
                          onsubmit="return confirm('Supprimer le poste <%= s.name %>?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  <% } %>
</div>

<%- include('../partials/footer') %>
